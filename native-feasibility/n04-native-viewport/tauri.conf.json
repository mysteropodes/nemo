{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N04 Native Viewport Proof",
  "version": "0.1.0",
  "identifier": "life.mograph.nemo.n04-native-viewport-proof",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "N04 Native Viewport Proof",
        "width": 1060,
        "height": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/n04.png"]
  }
}
