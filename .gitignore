node_modules/
__pycache__/
*.py[cod]

# Receiver-local Buzz grants contain machine-specific checkout roots.
/.buzz/
.DS_Store
**/.DS_Store
src-tauri/target/
dist/
*.dmg
*.exe
*.msi
*.AppImage
*.deb
src-tauri/.tauri_private_key
src-tauri/strokemotion.key
src-tauri/strokemotion.key.pub
src-tauri/strokemotion_decoded.key
geometry-wasm/target/
# src/wasm/ (wasm-pack build output) is intentionally NOT ignored: the app
# has no build step that regenerates it before packaging (frontendDist just
# copies src/ verbatim), so it's committed like paper-full.min.js — a
# vendored build artifact, not something to regenerate on every checkout.
# Re-run `wasm-pack build --target web --out-dir ../src/wasm` from
# geometry-wasm/ after any change to geometry-wasm/src/.
vectorize-core/target/
vectorize-wasm/target/
# src/wasm-vectorize/ — same reasoning as src/wasm/ above, NOT ignored.
# Re-run `wasm-pack build --target web --out-dir ../src/wasm-vectorize`
# from vectorize-wasm/ after any change to vectorize-wasm/src/ or
# vectorize-core/src/.
.feedback

# Design handoff mockups / ad-hoc screenshots / local backups — working
# reference material, not part of the app itself. Excluded from the
# collaboration repo (2026-07) to keep it scoped to source code.
/backups/
/design/
/design-v2/
/design-v3/
/design-v4/
/docs/
*.zip

# Pre-public cleanup (2026-08). Kept on disk, out of the repo:
#  - /index.html is the original single-file "StrokeMotion v1.2" prototype,
#    untouched since the initial import and referenced by nothing. The real
#    entry point is src/index.html — note the leading slash, without it this
#    pattern would ignore that one too and silently break the build.
#  - CODEX_HANDOFF.md is internal agent-to-agent session handoff notes
#    (branch names, feedback triage), not documentation for contributors.
/index.html
/CODEX_HANDOFF.md

.wrangler/
.wrangler-dry-run/

# Worktrees created by Claude Code background tasks — local scratch, never committed.
.claude/worktrees/
