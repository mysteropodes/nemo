      "rust.desktop.shell -> rust.desktop.native.application.contract (lib.rs: mod native_application_contract;)",
      "rust.desktop.shell -> rust.desktop.native.application.ports (lib.rs: mod native_application_ports;)",
      "rust.desktop.shell -> rust.desktop.native.application.viewport (lib.rs: mod native_application_viewport;)",
      "rust.desktop.shell -> rust.desktop.native.dispatch (lib.rs: mod native_dispatch;)",
      "rust.desktop.shell -> rust.desktop.media (lib.rs: mod video_decode; mod media_probe; mod vectorize;)",
      "rust.desktop.shell -> rust.desktop.tasks (lib.rs: mod task_runtime;)",
      "rust.desktop.shell -> rust.desktop.play-observer (lib.rs: cfg-gated mod test_play_observer;)",
      "rust.desktop.mcp.adapter -> rust.desktop.native.dispatch (application_mcp.rs: use crate::native_dispatch::{...};)",
      "rust.desktop.mcp.adapter.tests -> rust.desktop.mcp.adapter (application_mcp_tests.rs: use crate::application_mcp::*;)",
      "rust.desktop.mcp.adapter.tests -> rust.desktop.native.application (application_mcp_tests.rs: use crate::native_application::{...};)",
      "rust.desktop.mcp.adapter.tests -> rust.desktop.native.application.contract (application_mcp_tests.rs: use crate::native_application_contract::{...};)",
      "rust.desktop.native.application -> rust.desktop.native.application.contract (native_application.rs: use crate::native_application_contract::*;)",
      "rust.desktop.native.application -> rust.desktop.native.application.ports (native_application.rs: use crate::native_application_ports::{...};)",
      "rust.desktop.native.application -> rust.desktop.native.dispatch (native_application.rs: use crate::native_dispatch::{...};)",
      "rust.desktop.native.application.commands -> rust.desktop.mcp.adapter (native_application_commands.rs: use crate::application_mcp::ApplicationMcp;)",
      "rust.desktop.native.application.commands -> rust.desktop.native.application (native_application_commands.rs: use crate::native_application::DesktopNativeApplication;)",
      "rust.desktop.native.application.commands -> rust.desktop.native.application.contract (native_application_commands.rs: use crate::native_application_contract::*;)",
      "rust.desktop.native.application.commands -> rust.desktop.native.application.ports (native_application_commands.rs: use crate::native_application_ports::{...};)",
      "rust.desktop.native.application.commands -> rust.desktop.native.application.viewport (native_application_commands.rs: use crate::native_application_viewport;)",
      "rust.desktop.native.application.commands -> rust.desktop.native.dispatch (native_application_commands.rs: use crate::native_dispatch::{...};)",
      "rust.desktop.native.application.tests -> rust.desktop.native.application (native_application_tests.rs: use crate::native_application::*;)",
      "rust.desktop.native.application.tests -> rust.desktop.native.application.contract (native_application_tests.rs: use crate::native_application_contract::{...};)",
      "rust.desktop.native.application.tests -> rust.desktop.native.application.ports (native_application_tests.rs: use crate::native_application_ports::{...};)",
      "rust.desktop.native.application.tests -> rust.desktop.native.application.viewport (native_application_replace_viewport_tests.rs: original viewport replacement controls)",
      "rust.desktop.native.application.tests -> rust.desktop.native.viewport (native_viewport_borrow_tests.rs: original viewport borrow controls)",
      "rust.desktop.native.application.contract -> rust.desktop.native.application.ports (native_application_contract.rs: use crate::native_application_ports::DesktopResourceResolver;)",
      "rust.desktop.native.application.ports.tests -> rust.desktop.native.application.ports (native_application_ports_tests.rs: use crate::native_application_ports::*;)",
      "rust.desktop.native.application.viewport -> rust.desktop.native.application.contract (native_application_viewport.rs: use crate::native_application_contract::{...};)",
      "rust.desktop.native.application.viewport -> rust.desktop.native.viewport (native_application_viewport.rs: use crate::native_viewport::NativeViewport;)",
      "rust.desktop.native.host.release.tests -> rust.desktop.mcp.adapter (native_object_host_tests.rs: production typed installer controls)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.application (native_application_dispatch_release_tests.rs: explicit import)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.application.contract (native_application_dispatch_release_tests.rs: explicit import)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.dispatch (native_application_dispatch_release_tests.rs: explicit import)",
      "rust.desktop.tasks.tests -> rust.desktop.tasks (task_runtime/tests.rs: use super::*;)",
      "rust.desktop.tasks.tests -> rust.desktop.play-observer (task_runtime/tests.rs: private cfg-gated observer controls)",
      "rust.desktop.tasks -> rust.desktop.play-observer (task_runtime.rs: cfg-gated private observer use;)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.application.commands (native_object_bootstrap_tests.rs: raw production bootstrap controls)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.application.viewport (native_object_desktop_preview_tests.rs: original retained viewport fixture)",
      "rust.desktop.native.host.release.tests -> rust.desktop.native.application.ports (native_object_export_tests.rs: real desktop artifact port only)",
      "rust.desktop.native.host.release.tests -> rust.desktop.media (native_media_host_tests.rs: T12/#2232 real ffmpeg decoder factory and lossless fixtures only)"
    ]
  },
  "exportedPort": {
    "source": "src-tauri/src/lib.rs has no `pub use` re-exports; the Tauri command functions registered via `tauri::generate_handler![...]` are Tauri's own invoke registration, not a Rust module export",
    "items": []
  },
  "features": {
    "declared": [
      "test-play-publication-observer",
      "test-object-window-probe",
      "test-p38-fixture-open-probe"
    ],
    "declaredNote": "O1/#1708, N25F3D3B2D2A/#1834 and P38/#1858 declare three separate default-off, private test-package features in src-tauri/Cargo.toml. Normal desktop builds expose none of these probes. The Linux target cfg selects the correct no-follow open flag for the private P38 fixture bridge; all other cfg predicates remain unchanged.",
    "allowedCfgs": [
      "test",
      "unix",
      "debug_assertions",
      "target_os = \"macos\"",
      "target_os = \"linux\""
    ]
  },
