{
  "schemaVersion": 1,
  "kind": "rust-crate",
  "policyId": "nemo.rust.nemo-desktop.edges",
  "status": "adopted",
  "purpose": "B01/#1046, N16/#1348 and N18A/#1367: permitted module edges, exported ports, external-crate ports and Cargo feature configuration of the native desktop crate (src-tauri), enforced through the normal local boundaries lane by the Rust-aware analyzer (scripts/nemo/lib/boundaries-rust.cjs). Module identity and layers come from rust.profile.json; this policy pins the application_mcp.rs <-> nemo-mcp transport port plus module-local Tauri-host <-> native-engine ports for the dormant bootstrap, commands, tests, viewport, concrete ports and dispatch seam.",
  "crate": "nemo",
  "root": "src-tauri/src/lib.rs",
  "sourceDir": "src-tauri/src",
  "profileModules": [
    "rust.desktop.shell",
    "rust.desktop.mcp.adapter",
    "rust.desktop.mcp.adapter.tests",
    "rust.desktop.native.viewport",
    "rust.desktop.native.application.ports",
    "rust.desktop.native.application.ports.tests",
    "rust.desktop.native.application.contract",
    "rust.desktop.native.application.viewport",
    "rust.desktop.native.application",
    "rust.desktop.native.application.commands",
    "rust.desktop.native.application.tests",
    "rust.desktop.native.host.release.tests",
    "rust.desktop.native.dispatch",
    "rust.desktop.media",
    "rust.desktop.tasks",
    "rust.desktop.play-observer",
    "rust.desktop.tasks.tests"
  ],
  "profileModulesNote": "The seventeen profile modules under sourceDir include the private, default-off O1 Play observer. rust.desktop.build (src-tauri/build.rs) is outside sourceDir (dir 'src-tauri', not 'src-tauri/src') and is not part of this crate's own module graph; it is named in unanalyzedModules below as a census entry only.",
  "layerRules": {
    "desktop-shell": {
      "allowedLayers": [
        "desktop-shell",
        "mcp-adapter",
        "bootstrap",
        "command-adapter",
        "host-seam",
        "host-contract",
        "host-ports",
        "viewport-owner",
        "viewport-adapter"
      ],
      "meaning": "lib.rs/main.rs (shell), media_probe.rs/vectorize.rs/video_decode.rs (media), task_runtime.rs (tasks) and the default-off test_play_observer.rs may depend on each other and declare the dormant host modules, never directly on tests"
    },
    "mcp-adapter": {
      "allowedLayers": [
        "host-seam"
      ],
      "meaning": "application_mcp.rs owns transport and may depend on the shared boxed native-dispatch seam, but not on bootstrap or sibling presentation/resource adapters"
    },
    "viewport-adapter": {
      "allowedLayers": [],
      "meaning": "native_viewport.rs is the platform surface adapter and does not reach the bootstrap, transport, contract or host ports"
    },
    "host-ports": {
      "allowedLayers": [],
      "meaning": "native_application_ports.rs owns concrete resource, artifact and shared-compositor ports without reaching host orchestration"
    },
    "host-contract": {
      "allowedLayers": [
        "host-ports"
      ],
      "meaning": "native_application_contract.rs validates versioned requests and admitted resources through the concrete resource resolver without reaching transport, bootstrap or presentation owners"
    },
    "viewport-owner": {
      "allowedLayers": [
        "host-contract",
        "viewport-adapter"
      ],
      "meaning": "native_application_viewport.rs retains the main-thread viewport and uses only the strict host contract plus platform viewport adapter"
    },
    "bootstrap": {
      "allowedLayers": [
        "host-contract",
        "host-ports",
        "host-seam"
      ],
      "meaning": "native_application.rs and native_application_release.rs own the dormant application core and terminal release lifecycle through the strict contract, concrete ports and shared dispatch seam; command and presentation concerns live in their own modules"
    },
    "command-adapter": {
      "allowedLayers": [
        "mcp-adapter",
        "bootstrap",
        "host-contract",
        "host-ports",
        "viewport-owner",
        "host-seam"
      ],
      "meaning": "native_application_commands.rs is the dormant Tauri command surface and composes existing owners without becoming another state authority"
    },
    "host-seam": {
      "allowedLayers": [],
      "meaning": "native_dispatch.rs owns the shared boxed application seam and export pump. It is depended on by owners, but does not reach back into the MCP adapter, application bootstrap or viewport."
    },
    "host-release-tests": {
      "allowedLayers": [
        "bootstrap",
        "host-contract",
        "host-seam",
        "mcp-adapter",
        "command-adapter",
        "viewport-owner",
        "host-ports",
        "desktop-shell"
      ],
      "meaning": "Private host lifecycle tests reach the application owner, strict host contract, boxed dispatch seam and production typed installation adapter. Raw-bootstrap controls reach the command owner; desktop-preview tests reach the original viewport owner. N25F3D3C2B/#1832 export controls alone pass the real DesktopArtifactPort through the original host seam. Production layer permissions are unchanged."
    },
    "tests": {
      "allowedLayers": [
        "desktop-shell",
        "mcp-adapter",
        "bootstrap",
        "command-adapter",
        "host-contract",
        "host-ports",
        "viewport-owner",
        "viewport-adapter"
      ],
      "meaning": "Focused tests may reach their declared owners but not the shared host-seam directly: task-runtime, MCP, application and concrete-port tests each name the production module they exercise"
    }
  },
  "permittedEdges": {
    "note": "Observed at adoption from `mod …;` declarations in lib.rs (the crate root) and `use super::*;` in task_runtime/tests.rs (analyzer output). Layer rules are the enforced contract; this list documents which edges exist so a new one is a visible diff. Plain function-call references such as `video_decode::VideoSessions::default()` in lib.rs are unqualified sibling-module paths, not `crate::`/`super::`/`self::` paths, so they are outside what this analyzer resolves and add no edges beyond the `mod …;` declarations already listed.",
    "edges": [
      "rust.desktop.shell -> rust.desktop.mcp.adapter (lib.rs: mod application_mcp;)",
      "rust.desktop.shell -> rust.desktop.native.viewport (lib.rs: mod native_viewport;)",
