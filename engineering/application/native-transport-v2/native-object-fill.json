            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{8}$"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "remove": {
            "type": "boolean"
          }
        }
      }
    },
    "ObjectFillBrushPayload": {
      "order": 259,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "layerUid",
          "contextId",
          "frame",
          "outline",
          "color",
          "opacity",
          "placement",
          "mask",
          "copies",
          "stamps"
        ],
        "properties": {
