            "const": "object.fill.brush"
          },
          "layerUid": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "contextId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "frame": {
            "$ref": "#/$defs/ObjectFrame"
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "point",
                "handleIn",
                "handleOut"
              ],
              "properties": {
                "point": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000,
                    "maximum": 1000000000000
                  }
                },
                "handleIn": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000,
                    "maximum": 1000000000000
                  }
                },
                "handleOut": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000,
                    "maximum": 1000000000000
                  }
                }
              }
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{8}$"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "placement": {
            "enum": [
              "above",
              "below",
              "merge"
            ]
          },
          "mask": {
            "anyOf": [
              {
                "const": false
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            ]
          },
          "copies": {
            "type": "array",
            "maxItems": 23,
            "items": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "number",
                "minimum": -1000000000000,
                "maximum": 1000000000000
              }
            }
          },
          "stamps": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "description": "Labs multi-frame draw: the other selected frames of the layer the committed shape is also stamped on.",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      }
