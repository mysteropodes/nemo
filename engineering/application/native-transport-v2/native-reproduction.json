{
  "capability": "native.reproduction",
  "definitions": {
    "ReproductionReportPayload": {
      "order": 184,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedContentRevision",
          "expectedSequence"
        ],
        "properties": {
          "expectedContentRevision": {
            "$ref": "#/$defs/Revision"
          },
          "expectedSequence": {
            "$ref": "#/$defs/Revision"
          }
        }
      }
    },
    "ReproductionReportResult": {
      "order": 185,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle",
          "verifiedContentRevision",
          "verifiedSequence"
        ],
        "properties": {
          "bundle": {
            "$ref": "#/$defs/ReproductionBundle"
          },
          "verifiedContentRevision": {
            "$ref": "#/$defs/Revision"
          },
          "verifiedSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          }
        },
        "description": "Both verified values equal the request tokens; verifiedContentRevision also equals the response envelope contentRevision. The native authority atomically verifies tokens, catalog provenance and exportable journal. Sequence exhaustion rejects."
      }
    },
    "ReproductionReplayPayload": {
      "order": 186,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle"
        ],
        "properties": {
          "bundle": {
            "$ref": "#/$defs/ReproductionBundle"
          }
        }
      }
    },
    "ReproductionBundle": {
      "order": 187,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "formatVersion",
          "apiVersion",
          "fixture",
          "command",
          "stableTarget",
          "clock",
          "seed",
          "versions",
          "commands"
        ],
        "properties": {
          "format": {
            "const": "nemo.native-opacity-reproduction"
          },
          "formatVersion": {
            "const": 1
          },
          "apiVersion": {
            "const": 2
          },
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "const": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "command": {
            "const": "layer.opacity.set"
          },
          "stableTarget": {
            "$ref": "#/$defs/StableTarget"
          },
          "clock": {
            "type": "null"
          },
          "seed": {
            "type": "null"
          },
          "versions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nativeEngine"
            ],
            "properties": {
              "nativeEngine": {
                "type": "string"
              }
            }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "expectedRevision",
                "value",
                "revision",
                "applied"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "expectedRevision": {
                  "$ref": "#/$defs/Revision"
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "revision": {
                  "$ref": "#/$defs/Revision"
                },
                "applied": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "description": "Complete encoded bundle is capped at 3072 bytes before replay. The native decoder additionally validates the pinned catalog identity and entire causal sequence."
      }
    },
    "ReproductionStatusResult": {
      "order": 188,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason",
          "commandCount",
          "exportable"
        ],
        "properties": {
          "state": {
            "enum": [
              "disabled",
              "recording",
              "invalid"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "not_catalog",
                  "not_pristine",
                  "already_opted_in",
                  "not_opted_in",
                  "empty_journal",
                  "failed_mutation",
                  "changed_retry",
                  "unsupported_transition",
                  "released",
                  "replaced",
                  "command_limit",
                  "byte_limit",
                  "invalid_projection"
                ]
              }
            ]
          },
          "commandCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "exportable": {
            "type": "boolean"
          }
        }
      }
    },
    "ReproductionExportResult": {
      "order": 189,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle"
        ],
        "properties": {
          "bundle": {
            "$ref": "#/$defs/ReproductionBundle"
          }
        }
      }
    },
    "ReproductionReplayState": {
      "order": 190,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "opacity",
          "undoDepth",
          "redoDepth"
        ],
        "properties": {
          "revision": {
            "$ref": "#/$defs/Revision"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "undoDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "redoDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          }
        }
      }
    },
    "ReproductionReplayResult": {
      "order": 191,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "initial",
          "steps"
        ],
        "properties": {
          "initial": {
            "$ref": "#/$defs/ReproductionReplayState"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "expectedRevision",
                "applied",
                "state"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "expectedRevision": {
                  "$ref": "#/$defs/Revision"
                },
                "applied": {
                  "type": "boolean"
                },
                "state": {
                  "$ref": "#/$defs/ReproductionReplayState"
                }
              }
            }
          }
        }
      }
    }
  },
  "requests": [
    {
      "order": 82,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "command.reproduction.opt_in"
              },
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        ]
      }
    },
    {
      "order": 83,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "query.reproduction.status"
              },
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        ]
      }
    },
    {
      "order": 84,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "query.reproduction.export"
              },
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        ]
      }
    },
    {
      "order": 85,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "query.reproduction.report"
              },
              "payload": {
                "$ref": "#/$defs/ReproductionReportPayload"
              }
            }
          }
        ]
      }
    },
    {
      "order": 86,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "query.reproduction.replay"
              },
              "payload": {
                "$ref": "#/$defs/ReproductionReplayPayload"
              }
            }
          }
        ]
      }
    }
  ]
}
