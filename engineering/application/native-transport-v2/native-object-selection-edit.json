            ],
            "properties": {
              "shape": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "stroke": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "ObjectClipboardPastePayload": {
      "order": 141,
      "schema": {
        "type": "object",
