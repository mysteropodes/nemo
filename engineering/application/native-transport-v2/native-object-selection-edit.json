{
  "capability": "native.object.selection-edit",
  "definitions": {
    "ObjectGeometry": {
      "order": 17,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "closed",
          "coordinateSpace",
          "handleSpace",
          "segments"
        ],
        "properties": {
          "kind": {
            "const": "cubic-path"
          },
          "closed": {
            "const": true
          },
          "coordinateSpace": {
            "const": "document-world"
          },
          "handleSpace": {
            "const": "relative"
          },
          "segments": {
            "type": "array",
            "minItems": 2,
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/ObjectSegment"
            },
            "description": "Matches the accepted renderer count boundary. Shared subset validator does not implement maxItems; N25A tests explicitly check this bound, not runtime admission."
          }
        }
      }
    },
    "ObjectClipPayload": {
      "order": 127,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contextId",
          "layerUid",
          "frame",
          "records"
        ],
        "properties": {
          "contextId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "layerUid": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "frame": {
            "$ref": "#/$defs/ObjectFrame"
          },
          "records": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectClipboardRecord"
            }
          },
          "groups": {
            "type": "object"
          },
          "rasters": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectClipboardRaster"
            }
          },
          "source": {
            "$ref": "#/$defs/ObjectClipboardSource"
          }
        },
        "description": "Detached copied selection carried inline. Bounded structural declaration only: the native owner validates every record and remaps every reference atomically. A paste request carrying the clip may use 65536 encoded bytes (every other shape-edit request keeps 4096).",
        "dependentRequired": {
          "rasters": [
            "source"
          ],
          "source": [
            "rasters"
          ]
        }
      }
    },
    "ObjectSelectionDeletePayload": {
      "order": 138,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "contextId",
          "layerUid",
          "frame",
          "mode",
          "strokeIds"
        ],
        "properties": {
          "command": {
            "const": "object.selection.delete"
          },
          "contextId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "layerUid": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "frame": {
            "$ref": "#/$defs/ObjectFrame"
          },
          "mode": {
            "enum": [
              "animation2d",
              "motion"
            ]
          },
          "strokeIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectEditId"
            }
          }
        }
      }
    },
    "ObjectSelectionDuplicatePayload": {
      "order": 139,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "contextId",
          "layerUid",
          "frame",
          "mode",
          "strokeIds"
        ],
        "properties": {
          "command": {
            "const": "object.selection.duplicate"
          },
          "contextId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "layerUid": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "frame": {
            "$ref": "#/$defs/ObjectFrame"
          },
          "mode": {
            "enum": [
              "animation2d",
              "motion"
            ]
          },
          "strokeIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectEditId"
            }
          },
          "offset": {
            "$ref": "#/$defs/ObjectVectorPair",
            "description": "Where the copies land, in the records' own space: the distance of an Alt-drag duplicate. Each component is finite and at most 1e6 in magnitude. Absent: the baseline 12 px nudge on both axes."
          },
          "others": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "description": "Shapes of OTHER layers the copy also takes: a selection that spans layers is cloned into the destination layer (baseline duplicateSelection materialises every selected path into the active layer), in the same transaction. Each layer is named once and is not the destination; its shapes are read at the cell its playhead shows and are never written. Absent: the selection is the destination layer's alone.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layerUid",
                "strokeIds"
              ],
              "properties": {
                "layerUid": {
                  "$ref": "#/$defs/ObjectEditId"
                },
                "strokeIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1024,
                  "items": {
                    "$ref": "#/$defs/ObjectEditId"
                  }
                }
              }
            }
          }
        }
      }
    },
    "ObjectLayerSplitPayload": {
