    "ObjectClipboardRecord": {
      "order": 358,
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "family",
              "target",
              "geometry",
              "fill"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "family": {
                "const": "closed-solid-fill-cubic-path"
              },
              "target": {
                "$ref": "#/$defs/ObjectTarget"
              },
              "geometry": {
                "$ref": "#/$defs/ObjectGeometry"
              },
              "fill": {
                "$ref": "#/$defs/ObjectSolidFill"
              },
              "effects": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "enabled"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "p1": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p2": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p3": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p4": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p5": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p6": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p7": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p8": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "keys": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "object"
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "family",
              "target",
              "geometry",
              "fill",
              "vector"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "family": {
                "const": "editable-vector-path"
              },
              "target": {
                "$ref": "#/$defs/ObjectTarget"
              },
              "geometry": {
                "$ref": "#/$defs/ObjectVectorGeometry"
              },
              "fill": {
                "$ref": "#/$defs/ObjectVectorFill"
              },
              "vector": {
                "$ref": "#/$defs/ObjectVectorBody"
              },
              "vectorExt": {
                "$ref": "#/$defs/ObjectClipboardVectorExt"
              },
              "effects": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "enabled"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "p1": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p2": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p3": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p4": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
                            }
                          ]
                        },
                        "p5": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/ObjectFiniteNumber"
