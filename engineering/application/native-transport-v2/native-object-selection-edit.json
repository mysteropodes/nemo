    "ObjectClipboardBitmapBrushSpec": {
      "order": 359,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tip",
          "size",
          "spacing",
          "scatter",
          "opacity",
          "color",
          "pressure",
          "seed"
        ],
        "properties": {
          "tip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "At most 255 UTF-8 bytes, no NUL; native storage validates exact authored spelling."
          },
          "size": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "spacing": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "scatter": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "opacity": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "seed": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "color": {
            "type": "string"
          },
          "pressure": {
            "type": "boolean"
          }
        }
      }
    },
    "ObjectClipboardBitmapBrush": {
      "order": 360,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bitmapBrushSpec",
          "brushGroupId"
        ],
        "properties": {
          "bitmapBrushSpec": {
            "$ref": "#/$defs/ObjectClipboardBitmapBrushSpec"
          },
          "brushGroupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "At most 255 UTF-8 bytes, no NUL; native storage validates exact authored spelling."
          },
          "preTextureStroke": {
            "type": [
              "string",
              "null"
            ]
          },
          "preTextureOpacity": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "bitmapPressureProfile": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/ObjectFiniteNumber"
              }
            }
          }
        }
      }
    },
    "ObjectClipboardVectorExt": {
      "order": 361,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "pressure": {
            "$ref": "#/$defs/ObjectVectorPressure"
          },
          "paramShape": {
            "$ref": "#/$defs/ObjectParamShape"
          },
          "boxAngle": {
            "$ref": "#/$defs/ObjectFiniteNumber"
          },
          "fillGradient": {
            "$ref": "#/$defs/ObjectVectorFillGradient"
          },
          "fillTrace": {
            "$ref": "#/$defs/ObjectFillTrace"
          },
          "isMask": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "maskMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "maskFeather": {
            "oneOf": [
              {
                "$ref": "#/$defs/ObjectFiniteNumber"
              },
              {
                "type": "null"
              }
            ]
          },
          "linkedFillId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "isLinkedFillCompanion": {
            "type": "boolean"
          },
          "bitmapBrush": {
            "$ref": "#/$defs/ObjectClipboardBitmapBrush"
          },
          "brushTexture": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "brushGroupId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "isBrushTextureCopy": {
                "const": true
              },
              "brushTexturePreset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "preTextureOpacity": {
                "type": "number"
              },
              "preTextureStroke": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  }
                ]
              },
              "strokeSeed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295,
                "description": "G16 option C: the anchor's stamping seed; native produces its dabs from it."
              }
            },
            "not": {
              "required": [
                "isBrushTextureCopy",
                "brushTexturePreset"
              ]
            },
            "description": "G16: the baseline serP brush-texture members of an anchor (preset, group, hidden paint) or a dab (copy flag, group)."
          },
          "shadow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channelTag"
            ],
            "properties": {
              "channelTag": {
                "const": "shadow"
              },
              "shadowSwatchId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "isFillShape": {
            "const": true
          },
          "pointTypes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 256,
            "items": {
              "enum": [
                "corner",
                "smooth",
                "symmetric"
              ]
            },
            "description": "Optional per-vertex point-type hint aligned with geometry.segments; absent means inferred from the handles. Never on a pressure ribbon."
          },
          "xformAnchorKey": {
            "enum": [
              "tl",
              "tc",
              "tr",
              "ml",
              "mc",
              "mr",
              "bl",
              "bc",
              "br"
            ],
            "description": "The Select rotate/scale pivot preset the artist last chose for this stroke; a stored xformAnchorCustom wins over it."
          },
          "xformAnchorCustom": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/ObjectFiniteNumber"
            },
            "description": "The Select rotate/scale pivot as a custom world point [x, y]."
          }
        },
        "minProperties": 1,
        "description": "Omitted when empty.",
        "not": {
          "required": [
            "pressure",
            "fillGradient"
          ]
        }
      }
    },
    "ObjectClipboardRaster": {
      "order": 362,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "item"
        ],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contextId",
              "frameScope",
              "layerUid",
              "strokeId"
            ],
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1
              },
              "frameScope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "frame"
                ],
                "properties": {
                  "kind": {
                    "const": "authored"
                  },
                  "frame": {
                    "$ref": "#/$defs/ObjectFrame"
                  }
                }
              },
              "layerUid": {
                "type": "string",
                "minLength": 1,
                "description": "The source id of a layer in this batch, or the uid of an existing layer."
              },
              "strokeId": {
                "$ref": "#/$defs/ObjectEditId"
              }
            }
          },
          "item": {
            "$ref": "#/$defs/ObjectImportRasterItem"
          }
        }
      }
    },
    "ObjectClipboardSource": {
      "order": 363,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "documentId",
          "contentRevision",
          "strokeIds"
        ],
        "properties": {
          "instanceId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "documentId": {
            "$ref": "#/$defs/ObjectEditId"
          },
          "contentRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "strokeIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectEditId"
            }
          }
        }
      }
    }
  },
  "requests": [
    {
      "order": 40,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/RequiredRevisionRequest"
          },
          {
            "properties": {
