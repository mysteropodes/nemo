              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "removeControl"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
