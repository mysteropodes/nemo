                  "kind",
                  "code"
                ],
                "properties": {
                  "kind": {
                    "const": "setExpression"
                  },
                  "code": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Exact authored source. Native validators bound it to 4096 UTF-8 bytes; the empty string stays present-but-empty and only removeExpression clears an expression."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
