                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "frame"
                ],
                "properties": {
                  "kind": {
                    "const": "removeKey"
                  },
                  "frame": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "frame",
                  "animated"
                ],
                "properties": {
                  "kind": {
                    "const": "setAnimated"
