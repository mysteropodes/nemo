{
  "capability": "native.object.import",
  "definitions": {
    "ObjectImportPoint": {
      "order": 159,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "ObjectImportSolid": {
      "order": 160,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "r",
          "g",
          "b",
          "a"
        ],
        "properties": {
          "kind": {
            "const": "solid"
          },
          "r": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "g": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "b": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "a": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "ObjectImportSegment": {
      "order": 161,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point",
          "handleIn",
          "handleOut"
        ],
        "properties": {
          "point": {
            "$ref": "#/$defs/ObjectImportPoint"
          },
          "handleIn": {
            "$ref": "#/$defs/ObjectImportPoint"
          },
          "handleOut": {
            "$ref": "#/$defs/ObjectImportPoint"
          }
        }
      }
    },
    "ObjectImportVectorRecord": {
      "order": 162,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "family",
          "target",
          "geometry"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "family": {
            "const": "editable-vector-path"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contextId",
              "frameScope",
              "layerUid",
              "strokeId"
            ],
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1
              },
              "frameScope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "frame"
                ],
                "properties": {
                  "kind": {
                    "const": "authored"
                  },
                  "frame": {
                    "$ref": "#/$defs/ObjectFrame"
                  }
                }
              },
              "layerUid": {
                "type": "string",
                "minLength": 1,
                "description": "The source id of a layer in this batch, or the uid of an existing layer."
              },
              "strokeId": {
                "const": "",
                "description": "The owner mints every stroke id."
              }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "closed",
              "coordinateSpace",
              "handleSpace",
              "segments"
            ],
            "properties": {
              "kind": {
                "const": "cubic-path"
              },
              "closed": {
                "type": "boolean"
              },
              "coordinateSpace": {
                "const": "document-world"
              },
              "handleSpace": {
                "const": "relative"
              },
              "segments": {
                "type": "array",
                "minItems": 2,
                "maxItems": 256,
                "items": {
                  "$ref": "#/$defs/ObjectImportSegment"
                }
              }
            }
          },
          "fill": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/ObjectImportSolid"
              }
            ]
          },
          "vector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stroke",
              "hasRealStroke",
              "strokeWidth",
              "strokeCap",
              "strokeJoin",
              "opacity"
            ],
            "properties": {
              "stroke": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/ObjectImportSolid"
                  }
                ]
              },
              "hasRealStroke": {
                "type": "boolean",
                "description": "True exactly when stroke is not null."
              },
              "strokeWidth": {
                "type": "number"
              },
              "strokeCap": {
                "enum": [
                  "butt",
                  "round",
                  "square"
                ]
              },
              "strokeJoin": {
                "enum": [
                  "miter",
                  "round",
                  "bevel"
                ]
              },
              "miterLimit": {
                "type": "number"
              },
              "dashArray": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "dashOffset": {
                "type": "number"
              },
              "opacity": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "ObjectImportLayer": {
      "order": 163,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "name"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ObjectImportRecord": {
      "order": 164,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "record"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "record": {
            "$ref": "#/$defs/ObjectImportVectorRecord"
          }
        }
      }
    },
    "ObjectImportSkip": {
      "order": 165,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sourceId",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "layer",
              "element",
              "asset"
            ]
          },
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ObjectImportUnavailable": {
      "order": 166,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "need"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "need": {
            "enum": [
              "raster-asset",
              "text",
              "font"
            ]
          }
        }
      }
    },
    "ObjectImportBatchPayload": {
      "order": 167,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "layers",
          "records"
        ],
        "properties": {
          "command": {
            "const": "object.import.batch"
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportLayer"
            }
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportRecord"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportSkip"
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportUnavailable"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportAsset"
            }
          },
          "raster": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportRaster"
            }
          },
          "text": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ObjectImportText"
            }
          },
          "objectOrder": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ObjectImportSourceId"
            },
            "description": "Exact permutation of every new records/raster/text sourceId only. Excludes layers, assets, skips and origin objects. Absence preserves canonical family ordering; receipt order remains records then raster then text. Native owner validates coverage before one publication."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/ObjectImportSource"
            }
          },
          "documentSnapshotId": {
            "$ref": "#/$defs/Identifier"
          },
          "lifecycleGeneration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "description": "One atomic import batch. Optional assets/raster/text default to empty. Optional nonempty sources uses only the existing native scoped PNG file or bundled/Google font descriptors and requires the captured documentSnapshotId/lifecycleGeneration. No inline bytes, URL, AssetRecord or provider claim is admitted. The original request is fingerprinted before source IO, then the same lifecycle/owner is rechecked before one commit. Retained assets then sources share the asset ID space and receipt order. An unavailable row refuses the whole batch. Complete request remains 4096 bytes; owner/provider admission and saveability are authoritative.",
        "allOf": [
          {
            "if": {
              "required": [
                "sources"
              ]
            },
            "then": {
              "required": [
                "documentSnapshotId",
                "lifecycleGeneration"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documentSnapshotId"
                    ]
                  },
                  {
                    "required": [
                      "lifecycleGeneration"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "ObjectImportAsset": {
      "order": 339,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "assetId"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "assetId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          }
        },
        "description": "Reuse a record already retained by the pinned origin project inventory. No bytes, asset record, locator or provider claim is accepted. The owner resolves and validates the actual image/font record."
      }
    },
    "ObjectImportFont": {
      "order": 341,
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fontKey"
            ],
            "properties": {
              "kind": {
                "const": "bundled"
              },
              "fontKey": {
                "enum": [
                  "Roboto-Regular",
                  "Roboto-Bold",
                  "DejaVuSans-Regular",
                  "DejaVuSans-Bold",
                  "DejaVuSerif-Regular",
                  "DejaVuSerif-Bold",
                  "Manrope-Regular",
                  "Inter-Regular"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "assetId"
            ],
            "properties": {
              "kind": {
                "const": "asset"
              },
              "assetId": {
                "$ref": "#/$defs/ObjectImportSourceId"
              }
            }
          }
        ]
      }
    },
    "ObjectImportTextBlock": {
      "order": 342,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "font",
          "size",
          "color",
          "align",
          "anchorTopLeft"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "description": "No NUL, at least one non-ECMAScript-trim-whitespace unit, at most 65536 UTF-16 units; native decode repeats these rules on original JSON bytes."
          },
          "font": {
            "$ref": "#/$defs/ObjectImportFont"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "align": {
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "fixedWidth": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "fixedHeight": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "bold": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "underline": {
            "type": "boolean"
          },
          "strike": {
            "type": "boolean"
          },
          "letterSpacing": {
            "type": "number"
          },
          "wordSpacing": {
            "type": "number"
          },
          "lineHeightMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "textCase": {
            "enum": [
              "none",
              "upper",
              "lower",
              "capitalize"
            ]
          },
          "anchorTopLeft": {
            "$ref": "#/$defs/ObjectImportPoint"
          }
        }
      }
    },
    "ObjectImportRaster": {
      "order": 343,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "entry"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "item"
            ],
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contextId",
                  "frameScope",
                  "layerUid",
                  "strokeId"
                ],
                "properties": {
                  "contextId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "frameScope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "frame"
                    ],
                    "properties": {
                      "kind": {
                        "const": "authored"
                      },
                      "frame": {
                        "$ref": "#/$defs/ObjectFrame"
                      }
                    }
                  },
                  "layerUid": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The source id of a layer in this batch, or the uid of an existing layer."
                  },
                  "strokeId": {
                    "const": "",
                    "description": "The owner mints every stroke id."
                  }
                }
              },
              "item": {
                "$ref": "#/$defs/ObjectImportRasterItem"
              }
            }
          }
        }
      }
    },
    "ObjectImportText": {
      "order": 344,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "entry"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/ObjectImportSourceId"
          },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "block"
            ],
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contextId",
                  "frameScope",
                  "layerUid",
                  "strokeId"
                ],
                "properties": {
                  "contextId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "frameScope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "frame"
                    ],
                    "properties": {
                      "kind": {
                        "const": "authored"
                      },
                      "frame": {
                        "$ref": "#/$defs/ObjectFrame"
                      }
                    }
                  },
                  "layerUid": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The source id of a layer in this batch, or the uid of an existing layer."
                  },
                  "strokeId": {
                    "const": "",
                    "description": "The owner mints every stroke id."
                  }
                }
              },
              "block": {
                "$ref": "#/$defs/ObjectImportTextBlock"
              }
            }
          }
        }
      }
    },
    "ObjectImportSource": {
      "order": 345,
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "name",
              "mediaType",
              "source"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/ObjectImportSourceId"
              },
              "name": {
                "$ref": "#/$defs/ObjectImportSourceId"
              },
              "mediaType": {
                "const": "image/png"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                    "description": "Absolute native file path with no NUL; canonical regular-file and filesystem-scope permission checks stay in the existing native ImageSource resolver."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "name",
              "mediaType",
              "source"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/ObjectImportSourceId"
              },
              "name": {
                "$ref": "#/$defs/ObjectImportSourceId"
              },
              "mediaType": {
                "const": "font/ttf"
              },
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "fontKey"
                    ],
                    "properties": {
                      "kind": {
                        "const": "bundled"
                      },
                      "fontKey": {
                        "enum": [
                          "Roboto-Regular",
                          "Roboto-Bold",
                          "DejaVuSans-Regular",
                          "DejaVuSans-Bold",
                          "DejaVuSerif-Regular",
                          "DejaVuSerif-Bold",
                          "Manrope-Regular",
                          "Inter-Regular"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "family",
                      "weight",
                      "italic"
                    ],
                    "properties": {
                      "kind": {
                        "const": "google"
                      },
                      "family": {
                        "$ref": "#/$defs/ObjectImportSourceId"
                      },
                      "weight": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "italic": {
                        "type": "boolean"
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "requests": [
    {
      "order": 50,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/RequiredRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "command.document.object.import.batch"
              },
              "payload": {
                "$ref": "#/$defs/ObjectImportBatchPayload"
              }
            }
          }
        ]
      }
    }
  ]
}
