          {
            "$ref": "#/$defs/RequiredRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "command.document.object.property.keys.paste"
              },
              "payload": {
                "$ref": "#/$defs/ObjectPropertyKeysPastePayload"
              }
            }
          }
        ]
      }
    },
    {
      "order": 69,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/RequiredRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "command.document.object.property.batch"
              },
              "payload": {
                "$ref": "#/$defs/ObjectPropertyBatchEditPayload"
              }
            }
          }
        ]
      }
    }
  ]
}
