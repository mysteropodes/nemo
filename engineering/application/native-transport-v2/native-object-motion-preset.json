{
  "capability": "native.object.motion-preset",
  "definitions": {
    "ObjectPropertyPresetKey": {
      "order": 103,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "v"
        ],
        "properties": {
          "frame": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          },
          "v": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            }
          },
          "hold": {
            "type": "boolean"
          },
          "lockTo": {
            "enum": [
              "in",
              "out",
              "layer"
            ]
          },
          "curvePoints": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                "tx": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                "ty": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                }
              }
            }
          },
          "hIn": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            }
          },
          "hOut": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            }
          }
        }
      }
    },
    "ObjectPropertyPresetApplyPayload": {
      "order": 104,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "target",
          "properties"
        ],
        "properties": {
          "command": {
            "const": "object.property.preset.apply"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contextId",
              "layerUid"
            ],
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "layerUid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "keys"
              ],
              "properties": {
                "property": {
                  "enum": [
                    "position",
                    "anchor",
                    "rotation",
                    "scale",
                    "opacity"
                  ]
                },
                "keys": {
                  "type": "array",
                  "maxItems": 512,
                  "items": {
                    "$ref": "#/$defs/ObjectPropertyPresetKey"
                  }
                },
                "static": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000,
                    "maximum": 1000000000
                  }
                }
              }
            }
          }
        }
      }
    },
    "ObjectPropertyKeysPastePayload": {
      "order": 105,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "frame",
          "tracks"
        ],
        "properties": {
          "command": {
            "const": "object.property.keys.paste"
          },
          "frame": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "The playhead the offsets are added to."
          },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "property",
                "keys"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "contextId",
                    "layerUid"
                  ],
                  "properties": {
                    "contextId": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    },
                    "layerUid": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    },
                    "strokeId": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    }
                  }
                },
                "property": {
                  "$ref": "#/$defs/ObjectOpaqueId"
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 512,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dt",
                      "v"
                    ],
                    "properties": {
                      "dt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000,
                        "description": "Offset from the earliest copied key."
                      },
                      "v": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "items": {
                          "type": "number",
                          "minimum": -1000000000,
                          "maximum": 1000000000
                        }
                      },
                      "hold": {
                        "type": "boolean"
                      },
                      "curvePoints": {
                        "type": "array",
                        "maxItems": 64,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": -1000000000,
                              "maximum": 1000000000
                            },
                            "y": {
                              "type": "number",
                              "minimum": -1000000000,
                              "maximum": 1000000000
                            },
                            "tx": {
                              "type": "number",
                              "minimum": -1000000000,
                              "maximum": 1000000000
                            },
                            "ty": {
                              "type": "number",
                              "minimum": -1000000000,
                              "maximum": 1000000000
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ObjectPropertyBatchEditPayload": {
      "order": 106,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "edits"
        ],
        "properties": {
          "command": {
            "const": "object.property.batch"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "property",
                "action"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "contextId",
                    "layerUid"
                  ],
                  "properties": {
                    "contextId": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    },
                    "layerUid": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    },
                    "strokeId": {
                      "$ref": "#/$defs/ObjectOpaqueId"
                    }
                  }
                },
                "property": {
                  "$ref": "#/$defs/ObjectOpaqueId"
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "frame",
                        "values"
                      ],
                      "properties": {
                        "kind": {
                          "const": "setValue"
                        },
                        "frame": {
                          "type": "number",
                          "minimum": -1000000000,
                          "maximum": 1000000000
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "number",
                            "minimum": -1000000000,
                            "maximum": 1000000000
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "frame",
                        "values"
                      ],
                      "properties": {
                        "kind": {
                          "const": "setKey"
                        },
                        "frame": {
                          "type": "number",
                          "minimum": -1000000000,
                          "maximum": 1000000000
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "number",
                            "minimum": -1000000000,
                            "maximum": 1000000000
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "description": "#2520/#2525: several Motion value edits of one gesture (the multi-layer or multi-element box) as ONE revision and ONE history entry. Each entry is a setValue or setKey of the single property edit; two entries for one holder property are invalid_request."
      }
    }
  },
  "requests": [
    {
      "order": 67,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/RequiredRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "command.document.object.property.preset.apply"
              },
              "payload": {
