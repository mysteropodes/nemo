              },
              "scope": {
                "$ref": "#/$defs/ObjectTextReadScope"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "items": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target"
                  ],
                  "properties": {
                    "target": {
                      "$ref": "#/$defs/ObjectTextReadTarget"
                    }
                  }
                }
              },
              "nextOffset": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "documentId",
              "atRevision",
              "documentSnapshotId",
              "kind",
              "target",
              "textBytes",
              "block"
            ],
            "properties": {
              "instanceId": {
