              },
              "nextOffset": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 196608
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "documentId",
              "atRevision",
              "documentSnapshotId",
              "kind",
              "textBytes",
              "offset",
              "text",
              "nextOffset",
              "layerUid",
              "frame"
            ],
            "properties": {
              "instanceId": {
                "$ref": "#/$defs/Identifier"
              },
              "documentId": {
                "$ref": "#/$defs/Identifier"
              },
              "atRevision": {
                "$ref": "#/$defs/Revision"
              },
              "documentSnapshotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "kind": {
                "const": "animators"
              },
              "textBytes": {
                "type": "integer",
                "minimum": 0,
