              }
            }
          }
        ],
        "description": "At most 3072 UTF-8 encoded JSON result bytes; complete envelope at most4096. Chunk offsets count original UTF-8 text bytes, never UTF-16 code units. Pagination never splits a native identity or Unicode scalar."
      }
    }
  },
  "requests": [
    {
      "order": 118,
      "schema": {
        "allOf": [
          {
            "$ref": "#/$defs/ForbiddenRevisionRequest"
          },
          {
            "properties": {
              "operation": {
                "const": "query.document.object.text"
              },
              "payload": {
                "$ref": "#/$defs/ObjectTextReadPayload"
              }
            }
          }
        ]
      }
    }
  ]
}
