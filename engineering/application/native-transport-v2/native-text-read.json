                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "text": {
                "type": "string",
                "maxLength": 1024
              },
              "nextOffset": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                ]
              },
              "layerUid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "contextId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "frame": {
                "type": "number",
