{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mysteropodes/nemo/engineering/application/native-object-item-v1.schema.json",
  "description": "Lane-6 object operations: raster/text item edits and the embedded-image asset catalog. Request and result shapes of command.document.object.item.edit, command.document.object.asset.attach and command.document.object.asset.remove. The native owner repeats every rule on the original bytes; this document is the closed public shape.",
  "$comment": "Bounds, request/reply correlation and the 4096-byte envelope are also enforced by the SDK contract (native-object-item-contract.js) and the common Rust validators (native_item_contract.rs).",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "Opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S",
      "description": "Authored bytes are preserved; no identifier grammar is invented. Not blank. The schema is looser by design than the validators: maxLength counts characters here while the validators bound the UTF-8 byte length at 255, and the validators also refuse NUL."
    },
    "FrameScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "frame"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authored",
            "reference"
          ]
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "frameScope",
        "layerUid",
        "strokeId"
      ],
      "properties": {
        "contextId": {
          "const": "scene-root"
        },
        "frameScope": {
          "$ref": "#/$defs/FrameScope"
        },
        "layerUid": {
          "$ref": "#/$defs/Opaque"
        },
        "strokeId": {
          "$ref": "#/$defs/Opaque"
        }
      }
    },
    "CreateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "frameScope",
        "layerUid",
        "strokeId"
      ],
      "properties": {
        "contextId": {
          "const": "scene-root"
        },
        "frameScope": {
          "$ref": "#/$defs/FrameScope"
        },
        "layerUid": {
          "$ref": "#/$defs/Opaque"
        },
        "strokeId": {
          "const": ""
        }
      }
    },
    "RasterItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/Opaque"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "isBitmapBrush": {
          "type": "boolean"
        },
        "brushGroupId": {
          "$ref": "#/$defs/Opaque"
        },
        "isBrushTextureCopy": {
          "type": "boolean"
        },
        "meshId": {
          "$ref": "#/$defs/Opaque"
        }
      }
    },
    "Font": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fontKey"
          ],
          "properties": {
            "kind": {
              "const": "bundled"
            },
            "fontKey": {
              "enum": [
                "Roboto-Regular",
                "Roboto-Bold",
                "DejaVuSans-Regular",
                "DejaVuSans-Bold",
                "DejaVuSerif-Regular",
                "DejaVuSerif-Bold",
                "Manrope-Regular",
                "Inter-Regular"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "assetId"
          ],
          "properties": {
            "kind": {
              "const": "asset"
            },
            "assetId": {
              "$ref": "#/$defs/Opaque"
            }
          }
        }
      ]
    },
    "TextBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "font",
        "size",
        "color",
        "align",
        "anchorTopLeft"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/Font"
        },
        "size": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fixedWidth": {
          "type": [
            "number",
            "null"
          ]
        },
        "fixedHeight": {
          "type": [
            "number",
            "null"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "letterSpacing": {
          "type": "number"
        },
        "wordSpacing": {
          "type": "number"
        },
        "lineHeightMult": {
          "type": "number"
        },
        "textCase": {
          "enum": [
            "none",
            "upper",
            "lower",
            "capitalize"
          ]
        },
        "anchorTopLeft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "TextPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/Font"
        },
        "size": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fixedWidth": {
          "type": [
            "number",
            "null"
          ]
        },
        "fixedHeight": {
          "type": [
            "number",
            "null"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "letterSpacing": {
          "type": "number"
        },
        "wordSpacing": {
          "type": "number"
        },
        "lineHeightMult": {
          "type": "number"
        },
        "textCase": {
          "enum": [
            "none",
            "upper",
            "lower",
            "capitalize"
          ]
        }
      },
      "minProperties": 1
    },
    "ItemEdit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "target",
            "item"
          ],
          "properties": {
            "command": {
              "const": "object.raster.create"
            },
            "target": {
              "$ref": "#/$defs/CreateTarget"
            },
            "item": {
              "$ref": "#/$defs/RasterItem"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget",
            "x",
            "y"
          ],
          "properties": {
            "command": {
              "const": "object.raster.move"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget",
            "width",
            "height"
          ],
          "properties": {
            "command": {
              "const": "object.raster.resize"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget",
            "rotation"
          ],
          "properties": {
            "command": {
              "const": "object.raster.rotate"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            },
            "rotation": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget",
            "opacity"
          ],
          "properties": {
            "command": {
              "const": "object.raster.opacity"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            },
            "opacity": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget"
          ],
          "properties": {
            "command": {
              "const": "object.raster.delete"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "target",
            "block"
          ],
          "properties": {
            "command": {
              "const": "object.text.create"
            },
            "target": {
              "$ref": "#/$defs/CreateTarget"
            },
            "block": {
              "$ref": "#/$defs/TextBlock"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget",
            "patch"
          ],
          "properties": {
            "command": {
              "const": "object.text.edit"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            },
            "patch": {
              "$ref": "#/$defs/TextPatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "stableTarget"
          ],
          "properties": {
            "command": {
              "const": "object.text.delete"
            },
            "stableTarget": {
              "$ref": "#/$defs/Target"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "layerUid",
            "animator"
          ],
          "properties": {
            "command": {
              "const": "object.text.animator.upsert"
            },
            "layerUid": {
              "$ref": "#/$defs/Opaque"
            },
            "animator": {
              "$ref": "#/$defs/TextAnimator"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "layerUid",
            "animatorId"
          ],
          "properties": {
            "command": {
              "const": "object.text.animator.remove"
            },
            "layerUid": {
              "$ref": "#/$defs/Opaque"
            },
            "animatorId": {
              "$ref": "#/$defs/Opaque"
            }
          }
        }
      ]
    },
    "AssetAttach": {
      "oneOf": [
        {
          "$ref": "#/$defs/AssetCatalogAttach"
        },
        {
          "$ref": "#/$defs/ImageImportAttach"
        }
      ]
    },
    "AssetRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentSnapshotId",
        "assetId"
      ],
      "properties": {
        "documentSnapshotId": {
          "$ref": "#/$defs/Identifier"
        },
        "assetId": {
          "$ref": "#/$defs/Opaque"
        }
      }
    },
    "Input": {
      "oneOf": [
        {
          "$ref": "#/$defs/ItemEdit"
        },
        {
          "$ref": "#/$defs/AssetAttach"
        },
        {
          "$ref": "#/$defs/AssetRemove"
        }
      ]
    },
    "ItemEditResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "historyEntriesAdded",
        "operation",
        "strokeId"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "historyEntriesAdded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "operation": {
          "enum": [
            "raster.create",
            "raster.move",
            "raster.resize",
            "raster.rotate",
            "raster.opacity",
            "raster.delete",
            "text.create",
            "text.edit",
            "text.delete",
            "text.animator.upsert",
            "text.animator.remove"
          ]
        },
        "strokeId": {
          "$ref": "#/$defs/Opaque"
        }
      }
    },
    "AssetCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "historyEntriesAdded"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "historyEntriesAdded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Output": {
      "oneOf": [
        {
          "$ref": "#/$defs/ItemEditResult"
        },
        {
          "$ref": "#/$defs/AssetCommandResult"
        },
        {
          "$ref": "#/$defs/ImageImportResult"
        }
      ]
    },
    "AssetCatalogAttach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentSnapshotId",
        "name",
        "mediaType",
        "source"
      ],
      "properties": {
        "documentSnapshotId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Opaque"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/bmp",
            "image/svg+xml",
            "image/avif"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    },
    "ImageImportAttach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentSnapshotId",
        "name",
        "mediaType",
        "source",
        "placement",
        "lifecycleGeneration"
      ],
      "properties": {
        "documentSnapshotId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Opaque"
        },
        "mediaType": {
          "const": "image/png"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "lifecycleGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "placement": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "newLayer"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "layerUid",
                "frame"
              ],
              "properties": {
                "kind": {
                  "const": "authoredFrame"
                },
                "layerUid": {
                  "$ref": "#/$defs/Opaque"
                },
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          ]
        }
      }
    },
    "ImageImportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "historyEntriesAdded",
        "assetId",
        "naturalWidth",
        "naturalHeight",
        "displayWidth",
        "displayHeight",
        "target",
        "newLayer"
      ],
      "properties": {
        "applied": {
          "const": true
        },
        "historyEntriesAdded": {
          "const": 1
        },
        "assetId": {
          "$ref": "#/$defs/Opaque"
        },
        "naturalWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "naturalHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "displayWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "displayHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "target": {
          "$ref": "#/$defs/ImageImportTarget"
        },
        "newLayer": {
          "type": "boolean"
        }
      }
    },
    "ImageImportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "frameScope",
        "layerUid",
        "strokeId"
      ],
      "properties": {
        "contextId": {
          "const": "scene-root"
        },
        "frameScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "frame"
          ],
          "properties": {
            "kind": {
              "const": "authored"
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "layerUid": {
          "$ref": "#/$defs/Opaque"
        },
        "strokeId": {
          "$ref": "#/$defs/Opaque"
        }
      }
    },
    "TextAnimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selector"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Opaque"
        },
        "enabled": {
          "type": "boolean"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "start": {
              "type": [
                "number",
                "null"
              ]
            },
            "end": {
              "type": [
                "number",
                "null"
              ]
            },
            "offset": {
              "type": [
                "number",
                "null"
              ]
            },
            "shape": {
              "type": [
                "number",
                "null"
              ]
            },
            "amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "easeHigh": {
              "type": [
                "number",
                "null"
              ]
            },
            "easeLow": {
              "type": [
                "number",
                "null"
              ]
            },
            "smooth": {
              "type": [
                "number",
                "null"
              ]
            },
            "wiggleMin": {
              "type": [
                "number",
                "null"
              ]
            },
            "wiggleMax": {
              "type": [
                "number",
                "null"
              ]
            },
            "wigglesPerSec": {
              "type": [
                "number",
                "null"
              ]
            },
            "correlation": {
              "type": [
                "number",
                "null"
              ]
            },
            "seed": {
              "type": [
                "number",
                "null"
              ]
            },
            "selectorType": {
              "enum": [
                "range",
                "wiggly"
              ]
            },
            "units": {
              "enum": [
                "percent",
                "index"
              ]
            },
            "basedOn": {
              "enum": [
                "chars",
                "words",
                "lines"
              ]
            }
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "position": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "scale": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "rotation": {
              "type": [
                "number",
                "null"
              ]
            },
            "opacity": {
              "type": [
                "number",
                "null"
              ]
            },
            "fillColor": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              ],
              "items": false
            },
            "strokeColor": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              ],
              "items": false
            }
          }
        },
        "properties": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "property"
            ],
            "properties": {
              "property": {
                "enum": [
                  "start",
                  "end",
                  "offset",
                  "amount",
                  "easeHigh",
                  "easeLow",
                  "smooth",
                  "wiggleMin",
                  "wiggleMax",
                  "wigglesPerSec",
                  "correlation"
                ]
              },
              "static": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "track": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "keys"
                ],
                "properties": {
