        "requestId": "labs-1",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.labs.speedLines",
        "payload": {
          "command": "object.labs.speedLines",
          "layerUid": "layer-1",
          "frame": 3,
          "cx": 960,
          "cy": 540,
          "count": 60,
          "r0": 648,
          "r1": 1440,
          "jitter": 0.35,
          "seed": 424242,
          "color": [
            0,
            0,
            0,
            1
          ],
          "brushSize": 4,
          "opacity": 1
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "labs-1",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
