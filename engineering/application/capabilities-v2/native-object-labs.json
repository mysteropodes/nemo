{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.object.labs",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.labs.speedLines",
    "command.document.object.labs.boil",
    "command.document.object.labs.followPath",
    "command.document.object.labs.referenceFill",
    "command.document.object.labs.pingpong",
    "command.document.object.labs.retime",
    "command.document.object.labs.interval"
  ],
  "input": {
    "oneOf": [
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsSpeedLinesPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsBoilPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsFollowPathPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsReferenceFillPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsPingpongPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsRetimePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLabsIntervalPayload"
      }
    ]
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated retained receipt or typed refusal; the engine reads the shown drawing itself, so no record travels in the request. Requests above 4096 encoded bytes are refused, never split."
  },
  "semantics": "U36 (#2362): the baseline Labs generators as one native transaction each (src/js/labs/speed-lines.js, boil-effect.js, follow-path.js @1065e9d8). Speed lines rewrite the target cell as its shown drawing plus count seeded radial strokes (the baseline ensureKeyframe then append; the seed replaces Math.random). Boil writes keys frame+1..frame+frames with the shown drawing jittered by seededRng(0xB011 + k * seedStep), rasters and brush-texture dabs unjittered. Follow-path writes keys frame..frame+frames-1 holding the backdrop plus fresh-id copies of the moving strokes translated along the trajectory at ease(k/(frames-1)) of its arc length. Reference fill is the ordinary native bucket fill on the target cell with every other effectively visible scene-root layer's shown strokes added as walls (hidden layers and hidden folders, component instances, linked-fill companions and dabs excluded); the fill keeps its seed and gap but no wall ids, and a miss changes nothing. Boil and follow-path grow the timeline (and the work-area end, like Repeat) when needed. U35 timing actions (pingpong-cycle.js, retime-exposure.js, interval-assistant.js): ping-pong writes the block after the range reversed then forward `times` times, copying key, in-between and plain cells (no manual-edit flag); retime re-spaces the range keys from its first frame after wiping first..max(last, end); interval promotes eased non-key slots strictly inside the range to keys holding their shown drawing. Component layers are skipped. One history entry; a refusal publishes nothing. No JS/Paper writer or fallback.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
