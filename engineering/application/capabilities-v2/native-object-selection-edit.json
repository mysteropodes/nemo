{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.object.selection-edit",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.selection.delete",
    "command.document.object.selection.duplicate",
    "command.document.object.layer.split",
    "command.document.object.clipboard.paste",
    "command.document.object.clipboard.copy",
    "command.document.object.clipboard.cut"
  ],
  "input": {
    "oneOf": [
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectSelectionDeletePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectSelectionDuplicatePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerSplitPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectClipboardPastePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectClipboardCopyPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectClipboardCutPayload"
      }
    ]
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated retained receipt or typed refusal. Full original request and full response are limited to4096 encoded bytes; never split or truncate. Copy/cut may return only the bounded shape clipboard."
  },
  "semantics": "Delete or duplicate selected shapes, split a layer into one layer per element, or copy/cut/paste a bounded inline clip, by stable identity, atomically with element Motion, groups and references. Copy returns the pinned snapshot clip without revision, history or redo changes. Cut preflights the complete correlated response before committing its deletion. Nonempty successful cut adds one revision and one undo entry; empty selection returns null with no edit. Replay returns the original retained clipboard and disposition. Animation2D edits promote a held frame; Motion edits the inherited key. Unsupported family references refuse atomically. No JS/Paper writer or optimistic mutation.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
      "label": "Shared native selection.delete command; installed/UI acceptance remains pending",
      "request": {
        "apiVersion": 2,
        "requestId": "selection-edit-selection-delete-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.selection.delete",
        "payload": {
          "command": "object.selection.delete",
          "contextId": "scene-root",
          "layerUid": "layer-a",
          "frame": 0,
          "mode": "animation2d",
          "strokeIds": [
            "stroke-1"
          ]
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "selection-edit-selection-delete-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
