{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.property-read",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "query.document.object.property.read"
  ],
  "input": {
    "$ref": "../native-transport-v2.schema.json#/$defs/ObjectPropertyReadPayload"
  },
  "output": {
    "$ref": "../native-transport-v2.schema.json#/$defs/ObjectPropertyReadResult"
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "readPolicy": "Existing sole native owner selects the current immutable revision/snapshot. rawSample reuses native raw self sampling and deliberately ignores active expressions. authoredKeys returns admitted OrderKey DTOs with authored missing/null/empty fields unchanged; fixed-count pinned pages or unavailable, never a JS evaluator, mirror, default curve substitution, publication or ACK. expressionContext reads actual retained comp/self/key-count providers with explicit project-metadata unavailability; it grants no expression execution or writable authority. Optional mesh context binds the actual raster mesh in this context/layer, reads its rest UV/count only, and never adds rest sculpt to animated percent offsets.",
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "maxProviderResponseBytes": 3072,
    "policy": "Original bounded request and complete correlated response; oversized authored pages refuse unavailable without dynamic truncation or partial keys."
  },
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "not_found",
    "unavailable",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
