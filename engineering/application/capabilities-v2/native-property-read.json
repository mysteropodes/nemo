        "documentId": "native-object-document-1",
        "operation": "query.document.object.property.read",
        "payload": {
          "atRevision": 0,
          "documentSnapshotId": "native-object:native-object-document-1:0",
          "view": {
            "kind": "rawSample",
            "target": {
              "contextId": "scene-root",
              "layerUid": "L0"
            },
            "property": "opacity",
            "frame": -1.5
          }
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "property-raw",
        "instanceId": "d11-read-fixture",
        "documentId": "native-object-document-1",
        "contentRevision": 0,
        "ok": true,
        "result": {
          "instanceId": "d11-read-fixture",
          "documentId": "native-object-document-1",
          "atRevision": 0,
          "documentSnapshotId": "native-object:native-object-document-1:0",
