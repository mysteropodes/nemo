{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.object.import",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.import.batch"
  ],
  "input": {
    "$ref": "../native-transport-v2.schema.json#/$defs/ObjectImportBatchPayload"
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated import receipt or typed refusal. Whole request 4096 bytes; serialized result 3072 within the 4096-byte response. Retained assets use scalar origin assetId lookups. Optional sources admits only existing native scoped PNG files or bundled/Google font descriptors, with captured snapshot/lifecycle pins; never inline bytes, base64, URL, AssetRecord or provider claims. Existing resolver and shared resource budgets remain authoritative."
  },
  "semantics": "Import layers, vector/raster/Text records, retained asset descriptors and optional native source descriptors in one atomic batch. Source-free wire remains byte compatible. Nonempty sources requires the captured documentSnapshotId and lifecycleGeneration; the actual host probes the original request before source IO outside owner locks, then commits the exact ordered resolved sourceId/name/mediaType bytes bijection only against the same lifecycle/owner. Original request fingerprint/replay/cancel semantics remain; there is no separate asset attach/font publication. Source declarations are assets even without an item. Retained assets then sources share one unique source-ID space and assets receipt order; objects order is vector, raster then Text. Owner admission validates real PNG/font provenance, item references, order and project saveability before one revision/history checkpoint. Any unavailable row or invalid/stale source refuses the whole batch; no partial publication, JS/Paper writer or optimistic result. Actual host/new-byte, UI/installed and original importer consumer acceptance remain pending; no PSD canvas or Figma URL transport is introduced.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
