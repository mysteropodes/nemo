              "sourceId": "figma:0:svg:1:0",
              "record": {
                "schemaVersion": 1,
                "family": "editable-vector-path",
                "target": {
                  "contextId": "scene-root",
                  "frameScope": {
                    "kind": "authored",
                    "frame": 0
                  },
                  "layerUid": "figma:0",
                  "strokeId": ""
                },
                "geometry": {
                  "kind": "cubic-path",
                  "closed": false,
                  "coordinateSpace": "document-world",
                  "handleSpace": "relative",
                  "segments": [
                    {
                      "point": {
                        "x": 10,
                        "y": 20
                      },
                      "handleIn": {
                        "x": 0,
                        "y": 0
                      },
                      "handleOut": {
                        "x": 0,
                        "y": 0
                      }
                    },
                    {
                      "point": {
                        "x": 110,
                        "y": 70
                      },
                      "handleIn": {
                        "x": 0,
                        "y": 0
                      },
                      "handleOut": {
                        "x": 0,
                        "y": 0
                      }
                    }
                  ]
                },
                "fill": null,
                "vector": {
                  "stroke": {
                    "kind": "solid",
                    "r": 0.06666666666666667,
                    "g": 0.13333333333333333,
                    "b": 0.2,
                    "a": 1
                  },
                  "hasRealStroke": true,
                  "strokeWidth": 4,
                  "strokeCap": "butt",
                  "strokeJoin": "miter",
                  "miterLimit": 10,
                  "dashOffset": 0,
                  "opacity": 1
                }
              }
            }
          ],
          "skipped": [
            {
              "kind": "element",
              "sourceId": "figma:0:skip:0",
              "reason": "STAR (Star)"
            }
          ],
          "unavailable": []
        }
      },
      "response": {
        "apiVersion": 2,
