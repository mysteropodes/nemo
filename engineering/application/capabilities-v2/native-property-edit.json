{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.property-edit",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.property.edit"
  ],
  "input": {
    "$ref": "../native-transport-v2.schema.json#/$defs/ObjectPropertyEditPayload"
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete 4096-byte correlated property-edit request/receipt or typed refusal; no writable JS document mirror or binary resource payload."
  },
  "semantics": "Typed native object.property.edit intent: setValue(frame, values), setKey(frame, values), removeKey(frame), setAnimated(frame, animated). Stable contextId/layerUid and optional strokeId identify the holder; property is an opaque native selector. Frames preserve finite negative/fractional values; vectors contain 1..4 finite components with native-owned dimension/applicability validation. The native revision/history owner alone resolves static versus keyed writes and animation transitions. Changed edits add exactly one revision/history entry; no-op adds none and preserves redo. No custom curvePoints, expression edit, JS evaluator, metadata-based write grant or legacy fallback is admitted. Existing D12 property-track controls remain separate. Public route admission does not establish ordinary installed UI acceptance.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
      "label": "Native setValue; ordinary installed UI acceptance pending",
      "request": {
        "apiVersion": 2,
        "requestId": "property-setValue",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.property.edit",
        "payload": {
          "command": "object.property.edit",
          "target": {
            "contextId": "scene-root",
            "layerUid": "legacy layer:alpha"
          },
          "property": "position",
          "action": {
            "kind": "setValue",
            "frame": -0.5,
            "values": [
              1,
              2
            ]
          }
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "property-setValue",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
    {
