{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.opacity",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "documentKinds": ["opacity"],
  "purposes": {
    "command.document.apply": "Set the static opacity of a layer (opacity documents only).",
    "query.document.opacity": "Read the opacity of a layer (opacity documents only).",
    "query.document.revision": "Read the revision of an opacity document.",
    "query.document.snapshot.acquire": "Take a snapshot pin of an opacity document.",
    "query.document.serialize": "Serialize an opacity document.",
    "query.document.evaluate": "Evaluate layer values of an opacity document at a frame.",
    "transaction.begin": "Begin an opacity transaction.",
    "transaction.update": "Update an open opacity transaction.",
    "transaction.commit": "Commit an opacity transaction.",
    "transaction.cancel": "Cancel an opacity transaction.",
    "transaction.status": "Read the status of an opacity transaction.",
    "history.undo": "Undo the last opacity edit (opacity documents only).",
    "history.redo": "Redo the last undone opacity edit (opacity documents only).",
    "job.export.png.begin": "Start a PNG export job of an opacity document.",
    "job.export.png.status": "Read the status of a PNG export job.",
    "job.export.png.cancel": "Cancel a PNG export job."
  },
  "useInstead": {
    "object": {
      "command.document.apply": "command.document.object.property.edit",
      "query.document.opacity": "query.document.object.property.read",
      "query.document.revision": "query.document.object",
      "query.document.snapshot.acquire": "query.document.object",
      "query.document.serialize": "project.saveAs",
      "query.document.evaluate": "query.document.object.property.read",
      "transaction.begin": "command.document.object.property.edit",
      "transaction.update": "command.document.object.property.edit",
      "transaction.commit": "command.document.object.property.edit",
      "transaction.cancel": "command.document.object.undo",
      "transaction.status": "query.document.object.history",
      "history.undo": "command.document.object.undo",
      "history.redo": "command.document.object.redo",
      "job.export.png.begin": "project.export",
      "job.export.png.status": "project.export",
      "job.export.png.cancel": "project.export",
      "property.get": "query.document.object.property.read",
      "property.set": "command.document.object.property.edit",
      "property.key.set": "command.document.object.property.edit",
      "property.key.remove": "command.document.object.property.edit",
      "property.animation.set": "command.document.object.property.edit"
    }
  },
  "operations": [
    "command.document.apply",
    "query.document.opacity",
    "query.document.revision",
    "query.document.snapshot.acquire",
    "query.document.serialize",
    "query.document.evaluate",
    "transaction.begin",
    "transaction.update",
    "transaction.commit",
    "transaction.cancel",
    "transaction.status",
    "history.undo",
    "history.redo",
    "job.export.png.begin",
    "job.export.png.status",
    "job.export.png.cancel"
  ],
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "busy_conflict",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "domainErrorCodes": [
    "staging_failed",
    "frame_failed",
    "write_failed",
    "publish_failed",
    "cleanup_failed",
    "document_replaced"
  ],
  "authority": {
    "document": "native-engine::history::NativeOpacityHistory",
    "exportJobs": "native-engine::export_job::ExportJobManager",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxReadResponseBytes": 4096,
    "accepted": ["opaque geometry resource handle", "opaque output handle"],
    "forbidden": ["raw pixels", "binary payload", "canvas", "geometry JSON"]
  },
  "ports": [
    { "label": "ui", "state": "active" },
    { "label": "mcp", "state": "active" }
  ],
  "examples": [
    {
      "label": "UI and MCP use this identical opacity query",
      "request": {
        "apiVersion": 2,
        "requestId": "fixture-query",
        "instanceId": "instance-a",
        "documentId": "native-document-1",
        "operation": "query.document.opacity",
        "payload": { "stableTarget": { "layerUid": "r08_curve_layer" } }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "fixture-query",
        "instanceId": "instance-a",
        "documentId": "native-document-1",
        "contentRevision": 0,
        "ok": true,
        "result": { "atRevision": 0, "layerUid": "r08_curve_layer", "value": 25 }
      }
    },
    {
      "label": "PNG begin contains only bounded inputs and opaque handles",
      "request": {
        "apiVersion": 2,
        "requestId": "fixture-export",
        "instanceId": "instance-a",
        "documentId": "native-document-1",
        "expectedRevision": 0,
        "operation": "job.export.png.begin",
        "payload": {
          "contextId": "scene-root",
          "quality": "final",
          "outputHandle": "output/fixture",
          "frames": [{
            "sourceFrame": 0,
            "geometryHandle": { "resourceId": "geometry/r08", "resourceVersion": "v1" }
          }]
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "fixture-export",
        "instanceId": "instance-a",
        "documentId": "native-document-1",
        "contentRevision": 0,
        "ok": true,
        "result": {
          "jobId": "native-export-job-1",
          "status": "running",
          "pinnedRevision": 0,
          "documentSnapshotId": "native-opacity:native-document-1:0",
          "progress": 0,
          "artifact": null,
          "cleanup": { "status": "pending" },
          "externalEffectDisposition": "none"
        }
      }
    }
  ]
}
