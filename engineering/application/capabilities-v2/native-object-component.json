{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.object.component",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.component.convert",
    "command.document.object.component.expose",
    "command.document.object.component.place",
    "command.document.object.component.instance.set"
  ],
  "input": {
    "oneOf": [
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectComponentConvertPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectComponentExposePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectComponentPlacePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectComponentInstanceSetPayload"
      }
    ]
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated retained receipt or typed refusal; no document or resource payload. Requests above 4096 encoded bytes are refused, never split."
  },
  "semantics": "Convert one layer into a component in place or merge several layers into one new component instance, place an existing component as a new locked instance layer, expose a component property bound to one inner stroke, and edit the playback of a placed instance from the Component Instance panel (instance.set: any of mode loop|once|pingpong|single, singleFrame, placedAt, speed above zero and, with singleFrame, atFrame, the outer frame the playhead is on: an outer keyframe there also takes the pick as its component frame and loses its blank flag; only the named members change, a value equal to the stored one publishes nothing, a layer that is not a scene component instance is not_found), as sealed transactions through the single native owner. Targets are stable native layerUid and component symbolId values; the exposed-property key is made by the caller (ep_ plus the base-36 clock and four random base-36 digits, as the baseline expose()). One revision and one undo entry per applied edit; a no-op (the same exposed property twice) publishes nothing. A request made inside an open component, a v1 document, or a layer kind the baseline refuses is a typed refusal that publishes nothing. Animating a flat layer never converts it; only these requests do. No JS/Paper writer or optimistic mutation.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
