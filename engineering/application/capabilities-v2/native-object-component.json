      "request": {
        "apiVersion": 2,
        "requestId": "component-component-convert-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.component.convert",
        "payload": {
          "command": "object.component.convert",
          "contextId": "scene-root",
          "layerUids": [
            "layer-a",
            "layer-b"
          ]
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "component-component-convert-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1,
          "layerUid": "native-layer:8:0"
        }
      }
    },
    {
