{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.object",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "query.document.object",
    "command.document.object.layer.visibility.set",
    "command.document.object.undo",
    "command.document.object.redo"
  ],
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "busy_conflict",
    "not_found",
    "unavailable",
    "cancelled_before_dispatch",
    "internal"
  ],
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated envelope or typed unavailable; never truncate or simplify geometry.",
    "accepted": [
      "complete closed-solid-fill-cubic-path record within envelope byte limit"
    ]
  },
  "typedValueBoundary": "Closed typed shapes only; duplicate raw JSON keys already lost by Value parsing are not detectable. Availability requires a later strict raw-envelope gate.",
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
      "label": "Pinned object query through the shared v2 application route; requires an active object owner",
      "request": {
        "apiVersion": 2,
        "requestId": "object-read-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "operation": "query.document.object",
        "payload": {
          "atRevision": 7,
          "stableTarget": {
            "contextId": "scene-root",
            "frameScope": {
              "kind": "authored",
              "frame": 7
            },
            "layerUid": "legacy layer:alpha",
            "strokeId": "ink/path_A"
          }
        }
      }
    },
    {
      "label": "Current-revision object visibility command through the shared v2 route; requires an active object owner and subscriber",
      "request": {
        "apiVersion": 2,
        "requestId": "object-visibility-8",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.layer.visibility.set",
        "payload": {
          "command": "object.layer.visibility.set",
          "layerUid": "legacy layer:alpha",
          "visible": false
        }
      }
    },
    {
      "label": "Undo one object history entry through the shared v2 route; requires the current native owner revision",
      "request": {
        "apiVersion": 2,
        "requestId": "object-undo-9",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 8,
        "operation": "command.document.object.undo",
        "payload": { "command": "object.undo" }
      }
    },
    {
      "label": "Redo one object history entry through the shared v2 route; requires the current native owner revision",
      "request": {
        "apiVersion": 2,
        "requestId": "object-redo-10",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 9,
        "operation": "command.document.object.redo",
        "payload": { "command": "object.redo" }
      }
    },
    {
      "label": "Jump three entries back in one restore (the History panel's click); steps is optional and defaults to 1, the revision advances by exactly one",
      "request": {
        "apiVersion": 2,
        "requestId": "object-undo-jump-11",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 10,
        "operation": "command.document.object.undo",
        "payload": { "command": "object.undo", "steps": 3 }
      }
    }
  ]
}
