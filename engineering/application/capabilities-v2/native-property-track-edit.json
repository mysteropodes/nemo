{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.property-track-edit",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.property.track.edit"
  ],
  "input": {
    "$ref": "../native-transport-v2.schema.json#/$defs/ObjectPropertyTrackPayload"
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete 4096-byte correlated property-track request/receipt or typed refusal; no writable document or binary resource payload."
  },
  "semantics": "Edit only existing stable target/property selections (one key by `frame`, or the keys of one track inside inclusive `ranges` of frames, so a selection of any size is bounded by the request bytes alone and not by a key count; at most 32 single-key entries) through the native revision/history owner. Supports linear/ease/easeIn/easeOut/hold presets, in/out influence (finite inputs retain the native baseline clamp), subdivision, and lockTo (the per-key standing lock mode in/out/layer, or null to clear, written on every selected key), and the whole-selection key batches shift (whole-frame nudge or drag release; a key may not land before frame 0, past the last frame or on a key that stays), delete (a property left with no keys, static value or expression is dropped), flip (selected keys swap frame slots, each keeping its own value and curve) and distribute (selected keys spread evenly between the first and last, rounding halves up; a key landing on another key's frame replaces it, as the baseline assigned frames without a collision check). The authority resolves every selection on the original snapshot; missing or duplicate keys, unsupported properties and stale/cancelled requests cannot partially publish. Changed edits add one revision/history entry; no-op preserves authored presence and redo. This does not admit other property mutations or create a JS evaluator/writer. Public route availability is separate from installed curve UI acceptance.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
      "label": "Native track preset; installed curve UI acceptance pending",
      "request": {
        "apiVersion": 2,
        "requestId": "track-preset",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.property.track.edit",
        "payload": {
          "command": "object.property.track.edit",
          "selections": [
            {
              "target": {
                "contextId": "scene-root",
                "layerUid": "legacy layer:alpha"
              },
              "property": "position",
              "frame": 0
            }
          ],
          "action": {
            "kind": "preset",
            "preset": "ease"
          }
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "track-preset",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
