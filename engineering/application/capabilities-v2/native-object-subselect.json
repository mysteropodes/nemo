    }
  ],
  "examples": [
    {
      "label": "move a vertex through native history",
      "request": {
        "apiVersion": 2,
        "requestId": "subselect-example",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.subselect.edit",
        "payload": {
          "command": "object.subselect.edit",
          "stableTarget": {
            "contextId": "scene-root",
            "layerUid": "layer-a",
            "frameScope": {
