        "payload": {
          "command": "object.frames.remove",
          "from": 3,
          "to": 3
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "frames-remove-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
