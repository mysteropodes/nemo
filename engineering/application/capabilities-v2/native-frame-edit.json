    },
    "responseBytesByOperation": {
      "command.document.object.frames.insert": 4096,
      "command.document.object.frames.extend": 4096,
      "command.document.object.frames.duplicate": 4096,
      "command.document.object.frames.remove": 4096,
      "command.document.object.layer.key.promote": 4096,
      "command.document.object.layer.key.blank": 4096,
      "command.document.object.layer.key.clear": 4096,
      "command.document.object.layer.key.clear_cells": 4096,
      "command.document.object.layer.tween.remove": 4096,
      "command.document.object.layer.key.move": 4096,
      "command.document.object.frames.clipboard.duplicate": 4096,
