{
  "schemaVersion": 2,
  "apiVersion": 2,
  "id": "native.frame-edit",
  "version": 1,
  "status": "active",
  "availability": {
    "state": "available",
    "reason": null
  },
  "transportSchema": "../native-transport-v2.schema.json",
  "operations": [
    "command.document.object.frames.insert",
    "command.document.object.frames.extend",
    "command.document.object.frames.duplicate",
    "command.document.object.frames.remove",
    "command.document.object.layer.key.promote",
    "command.document.object.layer.key.clear",
    "command.document.object.layer.key.clear_cells",
    "command.document.object.layer.tween.remove",
    "command.document.object.layer.key.move",
    "command.document.object.frames.clipboard.duplicate",
    "command.document.object.frames.repeat"
  ],
  "input": {
    "oneOf": [
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesInsertPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesExtendPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesDuplicatePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesRemovePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerKeyPromotePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerKeyClearPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerKeyClearCellsPayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerTweenRemovePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectLayerKeyMovePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesClipboardDuplicatePayload"
      },
      {
        "$ref": "../native-transport-v2.schema.json#/$defs/ObjectFramesRepeatPayload"
      }
    ]
  },
  "authority": {
    "document": "native-engine::object_snapshot::ObjectSnapshot",
    "adapterOwnsWritableMirror": false,
    "fallback": "none"
  },
  "resourceBoundary": {
    "maxRequestBytes": 4096,
    "maxReadResponseBytes": 4096,
    "policy": "Complete correlated retained frame-edit receipt or typed refusal; no document, packet or resource payload. Lists are bounded by the 4096-byte request."
  },
  "semantics": "Eleven frame, key and exposure edits of the dense editor (F5/F6, extend, duplicate key, remove frame(s), clear key, delete frames, remove tween, move key, duplicate selection, repeat selection). Each is prepared against the retained snapshot and published through the shared revision, history and request-receipt owner: one changed operation adds one revision and one undo entry; a semantic no-op adds neither and keeps redo; a locked layer is skipped or refused exactly as the baseline does. Frame numbers are zero-based u32 cells; layers are named by their opaque stable layerUid. The result is the compact receipt only; cut, copy and paste are not declared because a clipboard packet is produced by the typed native API. F7 blank key is not declared. No JS/Paper writer, optimistic mutation or fallback.",
  "commonErrorCodes": [
    "invalid_request",
    "wrong_instance",
    "wrong_document",
    "stale_revision",
    "unavailable",
    "not_found",
    "cancelled_before_dispatch",
    "internal"
  ],
  "ports": [
    {
      "label": "ui",
      "state": "pending"
    },
    {
      "label": "mcp",
      "state": "pending"
    }
  ],
  "examples": [
    {
      "label": "F5 insert frame: one blank slot after the cell in the selected unlocked layers, the others padded; installed/UI acceptance remains pending",
      "request": {
        "apiVersion": 2,
        "requestId": "frames-insert-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.frames.insert",
        "payload": {
          "command": "object.frames.insert",
          "cell": 3
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "frames-insert-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
    {
      "label": "Extend exposure: insert count blank slots after the cell in every layer; installed/UI acceptance remains pending",
      "request": {
        "apiVersion": 2,
        "requestId": "frames-extend-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "expectedRevision": 7,
        "operation": "command.document.object.frames.extend",
        "payload": {
          "command": "object.frames.extend",
          "cell": 3,
          "count": 1
        }
      },
      "response": {
        "apiVersion": 2,
        "requestId": "frames-extend-7",
        "instanceId": "instance-A",
        "documentId": "document-A",
        "contentRevision": 8,
        "ok": true,
        "result": {
          "applied": true,
          "historyEntriesAdded": 1
        }
      }
    },
    {
