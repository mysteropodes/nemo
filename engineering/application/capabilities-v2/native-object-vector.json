            "schemaVersion": 1,
            "family": "editable-vector-path",
            "target": {
              "contextId": "scene-root",
              "frameScope": {
                "kind": "authored",
                "frame": 3
              },
              "layerUid": "layer-a",
              "strokeId": ""
            },
            "geometry": {
              "kind": "cubic-path",
              "closed": false,
              "coordinateSpace": "document-world",
              "handleSpace": "relative",
              "segments": [
                {
                  "point": {
                    "x": 10,
                    "y": 20
                  },
                  "handleIn": {
                    "x": 0,
                    "y": 0
                  },
                  "handleOut": {
                    "x": 0,
                    "y": 0
                  }
                },
                {
                  "point": {
                    "x": 110,
                    "y": 70
                  },
                  "handleIn": {
                    "x": 0,
                    "y": 0
                  },
                  "handleOut": {
                    "x": 0,
                    "y": 0
                  }
                }
              ]
            },
            "fill": null,
            "vector": {
              "stroke": {
                "kind": "solid",
                "r": 0,
                "g": 0.5,
                "b": 1,
                "a": 1
              },
              "hasRealStroke": true,
              "strokeWidth": 4,
              "strokeCap": "round",
              "strokeJoin": "round",
              "miterLimit": 10,
              "dashOffset": 0,
              "opacity": 1
            }
          }
        }
