{
  "apiVersion": 1,
  "request": {
    "$defs": {
      "Operation": {
        "enum": [
          "capabilities",
          "snapshot",
          "property.get",
          "property.set",
          "property.key.set",
          "property.key.remove",
          "property.animation.set",
          "history.undo",
          "history.redo",
          "diagnostics.trace",
          "diagnostics.replay"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "apiVersion": {
        "description": "Always 1; this transport speaks no other version.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "documentId": {
        "description": "Document identity from the latest `snapshot`. Required by every command; it\nchanges whenever the open document is replaced.",
        "type": [
          "string",
          "null"
        ]
      },
      "expectedRevision": {
        "description": "The `revision` of the latest snapshot. Required by every command, and the\nwrite is refused as stale if the document has moved on since.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "instanceId": {
        "description": "Instance identity from `nemo_discover` (`instances[].instanceId`). Required\nby every command.",
        "type": [
          "string",
          "null"
        ]
      },
      "operation": {
        "$ref": "#/$defs/Operation",
        "description": "The operation to run; its name selects the payload template below."
      },
      "payload": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "animated": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "frame": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "layerId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "property": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "request": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "animated": {
                "type": "boolean"
              },
              "frame": {
                "minimum": 0,
                "type": "integer"
              },
              "layerId": {
                "description": "layers[].layerUid from the latest snapshot.",
                "minLength": 1,
                "type": "string"
              },
              "property": {
                "const": "opacity"
              },
              "value": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "layerId",
              "property"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "request": {
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "enum": [
                      "capabilities",
                      "snapshot",
                      "property.get",
                      "property.set",
                      "property.key.set",
                      "property.key.remove",
                      "property.animation.set",
                      "history.undo",
                      "history.redo",
                      "diagnostics.trace",
                      "diagnostics.replay"
                    ]
                  },
                  "payload": true
                },
                "required": [
                  "operation",
                  "payload"
                ],
                "type": "object"
              }
            },
            "required": [
              "request"
            ],
            "type": "object"
          }
        ],
        "description": "Operation body. Always a JSON object, never a JSON-encoded string. Copy the template for the chosen operation:\n  property.set           {\"layerId\":\"layer-1\",\"property\":\"opacity\",\"value\":40}\n  property.key.set       {\"frame\":12,\"layerId\":\"layer-1\",\"property\":\"opacity\",\"value\":40}\n  property.key.remove    {\"frame\":12,\"layerId\":\"layer-1\",\"property\":\"opacity\",\"value\":40}\n  property.animation.set {\"animated\":true,\"layerId\":\"layer-1\",\"property\":\"opacity\"}\n  history.undo           {}\n  history.redo           {}\n  diagnostics.replay     {\"request\":{\"operation\":\"property.set\",\"payload\":{\"layerId\":\"layer-1\",\"property\":\"opacity\",\"value\":40}}}\n`property` selects a registered capability. The matching branch projects its exact input fields and JSON types; each full input/output descriptor is also exposed in `x-nemo-registeredCapabilities` for discovery clients.",
        "examples": [
          {
            "layerId": "layer-1",
            "property": "opacity",
            "value": 40
          },
          {
            "frame": 12,
            "layerId": "layer-1",
            "property": "opacity",
            "value": 40
          },
          {
            "frame": 12,
            "layerId": "layer-1",
            "property": "opacity",
            "value": 40
          },
          {
            "animated": true,
            "layerId": "layer-1",
            "property": "opacity"
          },
          {},
          {},
          {
            "request": {
              "operation": "property.set",
              "payload": {
                "layerId": "layer-1",
                "property": "opacity",
                "value": 40
              }
            }
          }
        ],
        "type": "object",
        "x-nemo-registeredCapabilities": [
          {
            "availability": {
              "reason": null,
              "state": "available"
            },
            "effects": {
              "kind": "mutation",
              "lifecycle": [
                "property.get",
                "property.set",
                "property.key.set",
                "property.key.remove",
                "property.animation.set"
              ],
              "scope": "document"
            },
            "examples": [
              {
                "input": {
                  "layerId": "layer-1",
                  "value": 40
                },
                "label": "set opacity to 40 on one layer",
                "output": {
                  "layerId": "layer-1",
                  "property": "opacity",
                  "value": 40
                }
              },
              {
                "input": {
                  "frame": 12,
                  "layerId": "layer-1",
                  "value": 40
                },
                "label": "key opacity at frame 12",
                "output": {
                  "layerId": "layer-1",
                  "property": "opacity",
                  "value": 40
                }
              },
              {
                "input": {
                  "animated": true,
                  "layerId": "layer-1"
                },
                "label": "enable animation on the property",
                "output": {
                  "layerId": "layer-1",
                  "property": "opacity",
                  "value": 40
                }
              }
            ],
            "fixture": {
              "input": {
                "layerId": "layer-1",
                "value": 40
              },
              "label": "set opacity to 40 on one layer",
              "output": {
                "layerId": "layer-1",
                "property": "opacity",
                "value": 40
              }
            },
            "handlerKey": "application.opacity.property",
            "id": "opacity",
            "input": {
              "additionalProperties": false,
              "properties": {
                "animated": {
                  "type": "boolean"
                },
                "frame": {
                  "minimum": 0,
                  "type": "integer"
                },
                "layerId": {
                  "description": "layers[].layerUid from the latest snapshot.",
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "layerId"
              ],
              "type": "object"
            },
            "output": {
              "additionalProperties": false,
              "properties": {
                "layerId": {
                  "type": "string"
                },
                "property": {
                  "const": "opacity"
                },
                "value": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "layerId",
                "property",
                "value"
              ],
              "type": "object"
            },
            "schemaVersion": 1,
            "units": {
              "value": "percent"
            },
            "version": 1
          },
          {
            "availability": {
              "reason": "missing-dependency",
              "state": "unavailable"
            },
            "effects": {
              "kind": "job",
              "lifecycle": [
                "start",
                "status",
                "cancel"
              ],
              "scope": "none"
            },
            "examples": [
              {
                "input": {
                  "frameIdx": 10
                },
                "label": "start",
                "output": {
                  "jobId": "job-1",
                  "progress": 0,
                  "status": "running"
                }
              },
              {
                "input": {
                  "jobId": "job-1"
                },
                "label": "status while rendering",
                "output": {
                  "jobId": "job-1",
                  "progress": 0.5,
                  "status": "running"
                }
              },
              {
                "input": {
                  "jobId": "job-1"
                },
                "label": "status once complete",
                "output": {
                  "artifact": {
                    "data": "<svg></svg>",
                    "mimeType": "image/svg+xml"
                  },
                  "jobId": "job-1",
                  "progress": 1,
                  "status": "succeeded"
                }
              },
              {
                "input": {
                  "jobId": "job-1"
                },
                "label": "cancel before completion",
                "output": {
                  "jobId": "job-1",
                  "progress": 0.5,
                  "status": "cancelled"
                }
              }
            ],
            "fixture": {
              "input": {
                "frameIdx": 10
              },
              "label": "export frame 10 as SVG, complete",
              "output": {
                "artifact": {
                  "data": "<svg></svg>",
                  "mimeType": "image/svg+xml"
                },
                "jobId": "job-1",
                "progress": 1,
                "status": "succeeded"
              }
            },
            "handlerKey": "application.export.svgFrame",
            "id": "export.svg.frame",
            "input": {
              "additionalProperties": false,
              "description": "What a caller supplies to invoke this capability. \"frameIdx\" addresses the \"start\" stage; \"jobId\" (returned by \"start\"'s output) addresses \"status\" and \"cancel\". Exactly one is required depending on stage, enforced by the handler per stage rather than by this shape — full per-stage input contracts are D02/#1045.",
              "properties": {
                "frameIdx": {
                  "description": "0-based timeline frame to export. Required for the \"start\" stage.",
                  "minimum": 0,
                  "type": "integer"
                },
                "jobId": {
                  "description": "Job identifier returned by \"start\". Required for the \"status\" and \"cancel\" stages.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "output": {
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "description": "Inline SVG document text.",
                      "type": "string"
                    },
                    "mimeType": {
                      "const": "image/svg+xml"
                    }
                  },
                  "required": [
                    "mimeType",
                    "data"
                  ],
                  "type": "object"
                },
                "error": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                },
                "jobId": {
                  "minLength": 1,
                  "type": "string"
                },
                "progress": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "status": {
                  "enum": [
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "jobId",
                "status"
              ],
              "type": "object"
            },
            "schemaVersion": 1,
            "units": {
              "progress": "ratio"
            },
            "version": 1
          }
        ]
      },
      "requestId": {
        "description": "Caller-chosen identity, 1..128 bytes. Re-sending it with an identical body\nreturns the retained result; re-sending it with a changed body is rejected.",
        "type": "string"
      }
    },
    "required": [
      "apiVersion",
      "requestId",
      "operation",
      "payload"
    ],
    "title": "ApplicationRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "ApplicationError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "apiVersion": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "documentId": {
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ApplicationError"
          },
          {
            "type": "null"
          }
        ]
      },
      "instanceId": {
        "type": "string"
      },
      "ok": {
        "type": "boolean"
      },
      "requestId": {
        "type": "string"
      },
      "result": true,
      "revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "apiVersion",
      "requestId",
      "instanceId",
      "documentId",
      "revision",
      "ok"
    ],
    "title": "ApplicationResponse",
    "type": "object"
  }
}
