{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nemo.native-layer-timing/1",
  "title": "Explicit sparse ordinary drawing timing stored in ObjectLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "family",
    "contextId",
    "keys",
    "samples"
  ],
  "properties": {
    "format": {
      "const": "nemo.native-layer-timing"
    },
    "formatVersion": {
      "const": 1
    },
    "family": {
      "const": "drawing"
    },
    "contextId": {
      "const": "scene-root"
    },
    "keys": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Key"
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Sample"
      }
    }
  },
  "description": "Both vectors strictly increase by frame, are disjoint, total <=4096, and every frame is below document totalFrames. Missing timing remains missing/Unavailable; null is invalid. New/Create seed explicit key0 only from authored intent. Core point read pins actual immutable IDs; no UI epoch, host API or framepacket acceptance. Components remain unsupported with retained baseline oracle.",
  "$defs": {
    "Frame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "Key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/Frame"
        }
      }
    },
    "Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "manualEdit": {
          "type": "boolean"
        }
      }
    },
    "Selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/CellSelector"
        },
        {
          "$ref": "#/$defs/RangeSelector"
        },
        {
          "$ref": "#/$defs/PlacementSelector"
        }
      ]
    },
    "ReadResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/CellReadResult"
        },
        {
          "$ref": "#/$defs/RangeReadResult"
        },
        {
          "$ref": "#/$defs/PlacementReadResult"
        }
      ]
    },
    "CellSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame"
      ],
      "properties": {
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        }
      },
      "description": "Original selector is bounded to4096bytes; exact actual immutable revision and snapshot token must match. Unsupported contexts return Unavailable. No caller-supplied lifecycle echo."
    },
    "RangeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame",
        "view"
      ],
      "properties": {
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "view": {
          "const": "range"
        }
      },
      "description": "Original selector is bounded to4096bytes; exact actual immutable revision and snapshot token must match. Unsupported contexts return Unavailable. No caller-supplied lifecycle echo."
    },
    "PlacementSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame",
        "view"
      ],
      "properties": {
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "view": {
          "const": "placement"
        }
      },
      "description": "Original selector is bounded to4096bytes; exact actual immutable revision and snapshot token must match. Unsupported contexts return Unavailable. No caller-supplied lifecycle echo."
    },
    "CellReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "documentId",
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame",
        "cellKind",
        "sourceFrame",
        "hasContent",
        "manualEdit"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "const": "scene-root"
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "cellKind": {
          "enum": [
            "key",
            "interpolated",
            "held",
            "unexposed"
          ]
        },
        "sourceFrame": {
          "oneOf": [
            {
              "$ref": "#/$defs/Frame"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasContent": {
          "type": "boolean"
        },
        "manualEdit": {
          "type": "boolean"
        }
      },
      "description": "Actual immutable identity and selected source; complete encoded result <=4096bytes or typed Unavailable. A core read is not live host/UI epoch admission or rendering/export acceptance."
    },
    "RangeReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId",
        "documentId",
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame",
        "range"
      ],
      "properties": {
        "kind": {
          "const": "layerRange"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "const": "scene-root"
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawInPoint",
            "rawOutPoint",
            "inPoint",
            "outPoint",
            "hasCustomRange",
            "hasTimeLink"
          ],
          "properties": {
            "rawInPoint": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            "rawOutPoint": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            "inPoint": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            "outPoint": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            "hasCustomRange": {
              "type": "boolean"
            },
            "hasTimeLink": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "PlacementReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId",
        "documentId",
        "atRevision",
        "documentSnapshotId",
        "contextId",
        "layerUid",
        "frame",
        "placement"
      ],
      "properties": {
        "kind": {
          "const": "layerPlacement"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "atRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "const": "scene-root"
        },
        "layerUid": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "placement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "placementId",
                "assetId",
                "assetKind",
                "offsetFrames",
                "timeRemap",
                "interpMode",
                "frameBlend",
                "sourceFrameCount"
              ],
              "properties": {
                "placementId": {
                  "type": "string",
                  "minLength": 1
                },
                "assetId": {
                  "type": "string",
                  "minLength": 1
                },
                "assetKind": {
                  "const": "video"
                },
                "offsetFrames": {
                  "type": "number"
                },
                "timeRemap": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "keyCount",
                        "keyAtFrame"
                      ],
                      "properties": {
                        "keyCount": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "keyAtFrame": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "interpMode": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    }
                  ]
                },
                "frameBlend": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "sourceFrameCount": {
                  "description": "T12: the source frame count of the desktop host's decode session bound to this placement and snapshot, as the decoder defines it; null when no session is bound or the count is unknown.",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    }
                  ]
                }
              }
            }
          ],
          "description": "T12: the layer's video drawing placement, or null. Remap keys are counted, never listed, so the read stays within 4096 bytes."
        }
      }
    }
  }
}
