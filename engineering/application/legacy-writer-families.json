      ],
      "kindPrefixes": [
        "opacity-"
      ],
      "note": "bootstrap/opacity-application.js also guards 'opacity-' + kind (set, key-current, key-frame, remove); a prefix family cannot be legacy-owned until its kinds are listed exactly."
    },
    {
      "family": "extensions",
      "authority": "unavailable",
      "entries": {
