{
  "schema": "nemo.legacy-writer-families/1",
  "purpose": "CS4b (#2364): the single declaration of legacy JavaScript/Paper writer entry points. scripts/nemo/legacy-writers.cjs generates the wrap lists (native-opacity-operations.js) and the desktop-admitted kinds (native-opacity-legacy-surface.js) from it. On the desktop host a write is admitted only when its family is legacy-owned; migrating a family flips its authority here.",
  "authorities": {
    "legacy-owned": "still owned by the JavaScript/Paper writer on desktop; admitted",
    "native": "owned by the native engine through the named capability; legacy entry refused",
    "unavailable": "not yet migrated; legacy entry refused and reported unavailable (EXECUTION_PLAN \u00a70)"
  },
  "prefixes": {
    "global": "app-",
    "timeline": "timeline-",
    "motion": "motion-",
    "script": "script-",
    "plugin": "plugin-"
  },
  "families": [
    {
      "family": "frames",
      "authority": "native",
      "capability": "native-frame-edit",
      "entries": {
        "global": [
          "insertFrame",
          "insertKeyframe",
          "insertKeyframeAt",
          "insertBlankKeyframe",
          "clearKeyframe",
          "convertToKeyframes",
          "removeFrameSpan"
        ],
        "timeline": [
          "insertFrame",
          "insertKeyframe",
          "insertBlankKeyframe",
          "removeFrame",
          "clearKeyframe",
          "convertToKeyframes",
          "removeFrameSpan",
          "duplicateSelectedFrames",
          "moveFrames",
          "cutFrames",
          "pasteFrames",
          "deleteSelectedFrames",
          "moveKeyframe",
          "shiftLayerFrames",
          "duplicateKeyframe",
          "extendExposure"
        ]
      },
      "kinds": [
        "timeline-duplicate-frames",
        "timeline-remove-frame"
      ]
    },
    {
      "family": "tween",
      "authority": "unavailable",
      "entries": {
        "global": [
