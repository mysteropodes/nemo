{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"nemo","version":"0.1.0"},"instructions":"Discover Nemo, select an instance, read snapshot, then use its identity and revision for commands. Nemo owns document state. After a cancelled or disconnected write query state before retrying; reuse the exact requestId and body for idempotent retries."}}
{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"nemo_command","description":"Call the same application command/history service as Nemo UI. Use the latest snapshot instanceId, documentId, expectedRevision and a unique requestId. Identical retries reuse their result; changed-body retries fail. Supports opacity editing/keying, undo/redo and diagnostic replay.","inputSchema":{"$defs":{"Operation":{"enum":["capabilities","snapshot","property.get","property.set","property.key.set","property.key.remove","property.animation.set","history.undo","history.redo","diagnostics.trace","diagnostics.replay"],"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"apiVersion":{"format":"uint32","minimum":0,"type":"integer"},"documentId":{"type":["string","null"]},"expectedRevision":{"format":"uint64","minimum":0,"type":["integer","null"]},"instanceId":{"type":["string","null"]},"operation":{"$ref":"#/$defs/Operation"},"payload":true,"requestId":{"type":"string"}},"required":["apiVersion","requestId","operation","payload"],"type":"object"}},{"name":"nemo_discover","description":"Discover running Nemo instances and their build identity. Launch Nemo if none respond. No document is edited.","inputSchema":{"properties":{},"type":"object"}},{"name":"nemo_query","description":"Read Nemo capabilities, current document snapshot, opacity property, or bounded diagnostics. Always select the instance from nemo_discover.","inputSchema":{"$defs":{"Operation":{"enum":["capabilities","snapshot","property.get","property.set","property.key.set","property.key.remove","property.animation.set","history.undo","history.redo","diagnostics.trace","diagnostics.replay"],"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"instance_id":{"description":"Instance returned by nemo_discover. Required when several apps are running.","type":"string"},"operation":{"$ref":"#/$defs/Operation","description":"capabilities, snapshot, property.get or diagnostics.trace."},"payload":{"default":{}}},"required":["instance_id","operation"],"type":"object"}}]}}
