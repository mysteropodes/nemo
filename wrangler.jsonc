{
	// Assets-only Worker (per Cloudflare's own Pages->Workers migration guide —
	// this is now the recommended path over `wrangler pages deploy`): src/ is
	// already the full static site root (plain <script> tags, no bundler), so
	// no "main" field is needed, just the directory to serve.
	"name": "nemo-editor",
	"compatibility_date": "2026-08-01",
	// "main" intercepts /api/google-font (live Google Fonts proxy for the web
	// build, worker/index.js) and falls through to the ASSETS binding for
	// everything else — same static site as before, just with one dynamic route.
	"main": "worker/index.js",
	"assets": { "directory": "./src", "binding": "ASSETS" },
	"routes": [
		{ "pattern": "nemomotion.org", "custom_domain": true },
		{ "pattern": "www.nemomotion.org", "custom_domain": true }
	]
}
