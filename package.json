{
  "name": "nemo",
  "version": "0.7.0-alpha.4",
  "description": "Open-source motion design and 2D animation in one app — a keyframe motion editor alongside frame-by-frame drawing with automatic inbetweening",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "serve": "python3 -m http.server 1420 -d src",
    "doctor": "node scripts/nemo/doctor.cjs",
    "check": "node scripts/nemo/check.cjs",
    "inventory": "node scripts/nemo/inventory.cjs",
    "fixtures": "node tests/fixtures/generate.cjs",
    "test": "node --test tests/*.test.cjs tests/animation/*.test.cjs",
    "test:rust": "node scripts/nemo/job.cjs test:rust",
    "test:integration": "node scripts/nemo/job.cjs test:integration",
    "test:browser": "node scripts/nemo/job.cjs test:browser",
    "test:desktop": "node scripts/nemo/job.cjs test:desktop",
    "native": "node scripts/nemo/native.cjs",
    "bench": "node scripts/nemo/job.cjs bench",
    "build:wasm": "node scripts/nemo/job.cjs build:wasm",
    "build:desktop": "node scripts/nemo/job.cjs build:desktop",
    "verify": "node scripts/nemo/verify.cjs"
  },
  "keywords": [
    "motion-design",
    "motion-graphics",
    "keyframe-animation",
    "2d-animation",
    "animation",
    "vector",
    "inbetweening"
  ],
  "author": "Cyril",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4"
  }
}
